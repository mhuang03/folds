import Lean.Elab.Term
import Folds.Defs

/-!
# LRAT certificates for admissible labellings: the checker (definitions only)

The functions here are evaluated by the kernel (`decide +kernel`) on the certificates of
`Folds/LabellingSAT*Certs*.lean`; their soundness is proved in `Folds/LabellingSAT.lean`.
This file does not import Mathlib, so that the certificate files, which only state the Boolean
checks, are elaborated with a small environment (memory).

## Data
* Literals are natural numbers: `2 * x` is the variable `x`, `2 * x + 1` its negation.
* A partial assignment is a natural number used as a bitmask (bit `l` set: literal `l` true);
  the kernel evaluates the bit operations with GMP.
* The clauses are stored in a binary trie keyed by the clause id (`Trie`), which is part of the
  certificate: ids `0, …, u-1` are the initial clauses (each with a tag `CTag`), ids `u, u+1, …`
  the clauses added by the proof steps.
* The functions evaluated by the kernel use the kernel-accelerated primitives `Nat.beq`,
  `Nat.blt`, `Nat.land`, `Nat.shiftRight`, ... directly (no type classes, no `Decidable`).

## Checks
* `Cert.initOK`: the initial clause with id `k` contains the clause generated by the `k`-th tag
  (`gen`), read through the variable table `vt`, and the tag is valid.
* `Cert.segOK a b`: the steps `a ≤ j < b` (clause id `u + j`) are reverse unit propagation
  (RUP) steps: starting from the negation of the clause, each hint (an id `< u + j`) is a unit
  clause, whose literal is set, until the last one is falsified.
* `Cert.endOK n`: the clause with id `empty` is empty, and `empty < u + n`.

## The encoding (`CTag`, `gen`)
Meaningful variables (`VarTag`): `y m u = [c m < u]`, and the totalizer outputs
`o m v lo hi i = [i ≤ #{p ∈ [lo, hi) : input p of the window sum of (m, v)}]`.  The window
inequality at `m` with `c m = v` reads `#{x ∈ L(m) : c x ≤ v} + #{x ∈ R(m) : c x ≥ v} ≤ r(m)`;
its left side is the window sum over the `2 r` inputs `inLit`, and the clause `win m v` says that
the totalizer output `r + 1` is false when `c m = v`.
-/

namespace Folds
namespace LSAT

/-! ## A binary trie keyed by natural numbers -/

/-- Binary trie: the root holds key `0`, key `k ≥ 1` goes left (key `k / 2`) if `k` is odd and
right (key `k / 2 - 1`) if `k` is even. -/
inductive Trie (α : Type) where
  | leaf : Trie α
  | node : Option α → Trie α → Trie α → Trie α

/-- Lookup with depth bound `d`. -/
def Trie.get {α : Type} : Nat → Trie α → Nat → Option α
  | _, leaf, _ => none
  | 0, node _ _ _, _ => none
  | d + 1, node v l r, k =>
    bif Nat.beq k 0 then v
    else bif Nat.beq (Nat.land k 1) 1 then get d l (Nat.shiftRight k 1)
    else get d r (Nat.sub (Nat.shiftRight k 1) 1)

/-- Depth bound of the tries. -/
def D : Nat := 64

/-! ## Literals, assignments, reverse unit propagation -/

/-- The negated literal. -/
def neg (l : Nat) : Nat := bif Nat.beq (Nat.land l 1) 0 then Nat.add l 1 else Nat.sub l 1

/-- Set the literal `l` in the bitmask `A`. -/
def setLit (A l : Nat) : Nat := Nat.lor A (Nat.pow 2 l)

/-- `l` is falsified by `A` (bit `neg l` of `A`). -/
def isFalse (A l : Nat) : Bool := Nat.beq (Nat.land (Nat.shiftRight A (neg l)) 1) 1

/-- The assignment falsifying the clause `C`. -/
def initA (C : List Nat) : Nat := C.foldl (fun A l => setLit A (neg l)) 0

/-- Clause database. -/
abbrev DB := Trie (List Nat)

/-- Unit propagation along the hints (ids `< bound`), from the assignment `A`: `true` iff a
conflict is reached, every hint before it being unit. -/
def rup (db : DB) (bound : Nat) : Nat → List Nat → Bool
  | _, [] => false
  | A, h :: hs =>
    bif Nat.blt h bound then
      match db.get D h with
      | none => false
      | some c =>
        match c.filter (fun l => !isFalse A l) with
        | [] => true
        | [u] => rup db bound (setLit A u) hs
        | _ :: _ :: _ => false
    else false

/-! ## The encoding -/

/-- Meaningful variables. -/
inductive VarTag where
  | none : VarTag
  | y (m u : Nat) : VarTag
  | o (m v lo hi i : Nat) : VarTag

/-- Boolean equality of variable tags. -/
def VarTag.beq : VarTag → VarTag → Bool
  | .none, .none => true
  | .y m u, .y m' u' => Nat.beq m m' && Nat.beq u u'
  | .o m v lo hi i, .o m' v' lo' hi' i' =>
    Nat.beq m m' && Nat.beq v v' && Nat.beq lo lo' && Nat.beq hi hi' && Nat.beq i i'
  | _, _ => false

/-- Literals over meaningful variables. -/
abbrev TLit := VarTag × Bool

/-- Input `p` of the window sum of `(m, v)`: for `p < r`, `[c (m - 1 - p) ≤ v]` (left window),
for `p ≥ r`, `[c (m + 1 + (p - r)) ≥ v]` (right window). -/
def inLit (N m v p : Nat) : TLit :=
  if p < reach N m then (.y (m - 1 - p) (v + 1), true) else (.y (m + 1 + (p - reach N m)) v, false)

/-- Totalizer output: a leaf is its input. -/
def oLit (N m v lo hi i : Nat) : TLit :=
  if hi = lo + 1 ∧ i = 1 then inLit N m v lo else (.o m v lo hi i, true)

/-- The negated literal. -/
def tneg (x : TLit) : TLit := (x.1, !x.2)

/-- Clause tags. -/
inductive CTag where
  /-- `¬ [c m < 0]` -/
  | lo (m : Nat) : CTag
  /-- `[c m < t]` -/
  | hi (m : Nat) : CTag
  /-- `[c m < u] → [c m < u + 1]` -/
  | ord (m u : Nat) : CTag
  /-- totalizer: `out(lo, mid, i) ∧ out(mid, hi, j) → out(lo, hi, k)` (`k ≤ i + j`) -/
  | tot (m v lo mid hi i j k : Nat) : CTag
  /-- the window inequality at `m` when `c m = v`: the root output `r + 1` is false -/
  | win (m v : Nat) : CTag

/-- The clause of a tag. -/
def gen (N t : Nat) : CTag → List TLit
  | .lo m => [(.y m 0, false)]
  | .hi m => [(.y m t, true)]
  | .ord m u => [(.y m u, false), (.y m (u + 1), true)]
  | .tot m v lo mid hi i j k =>
    (if i = 0 then [] else [tneg (oLit N m v lo mid i)]) ++
      (if j = 0 then [] else [tneg (oLit N m v mid hi j)]) ++ [oLit N m v lo hi k]
  | .win m v =>
    [(.y m (v + 1), false), (.y m v, true), tneg (oLit N m v 0 (2 * reach N m) (reach N m + 1))]

/-- The constraints that are encoded (`Folds.checked`). -/
def chk (left : Bool) (N m : Nat) : Bool :=
  decide (0 < reach N m) && (!left || decide (2 * m ≤ N + 1))

/-- The side conditions of a tag. -/
def valid (left : Bool) (N : Nat) : CTag → Bool
  | .lo _ => true
  | .hi m => decide (1 ≤ m) && decide (m ≤ N)
  | .ord _ _ => true
  | .tot _ _ lo mid hi i j k => decide (lo ≤ mid) && decide (mid ≤ hi) && decide (k ≤ i + j)
  | .win m _ => decide (1 ≤ m) && decide (m ≤ N) && chk left N m

/-- The compact literal `l` is the meaningful literal `x`. -/
def matchLit (vt : Trie VarTag) (x : TLit) (l : Nat) : Bool :=
  match vt.get D (Nat.shiftRight l 1) with
  | some g => g.beq x.1 && (Nat.beq (Nat.land l 1) 0 == x.2)
  | none => false

/-! ## Certificates -/

/-- A certificate: the variable table (compact variable `x` means `vt[x]`), the clauses by id,
the tags of the initial clauses (ids `0, …, u-1`), the hints of the proof steps (step `j` adds
the clause with id `u + j`), and the id of the empty clause. -/
structure Cert where
  vt : Trie VarTag
  db : Trie (List Nat)
  tags : List CTag
  hints : List (List Nat)
  empty : Nat

/-- The initial clauses `k, k+1, …` are generated by the valid tags `gs`. -/
def Cert.initGo (cert : Cert) (left : Bool) (N t : Nat) : Nat → List CTag → Bool
  | _, [] => true
  | k, g :: gs =>
    (valid left N g &&
      match cert.db.get D k with
      | some C => (gen N t g).all (fun x => C.any (matchLit cert.vt x))
      | none => false) &&
    cert.initGo left N t (k + 1) gs

/-- The initial clauses are generated by valid tags. -/
def Cert.initOK (cert : Cert) (left : Bool) (N t : Nat) : Bool :=
  cert.initGo left N t 0 cert.tags

/-- The steps with hints `hss`, adding the clauses `k, k+1, …`, are RUP steps. -/
def Cert.stepsOK (cert : Cert) : Nat → List (List Nat) → Bool
  | _, [] => true
  | k, hs :: hss =>
    (match cert.db.get D k with
      | some C => rup cert.db k (initA C) hs
      | none => false) &&
    cert.stepsOK (k + 1) hss

/-- The steps `a ≤ j < b` are RUP steps. -/
def Cert.segOK (cert : Cert) (a b : Nat) : Bool :=
  Nat.ble a b && Nat.ble b cert.hints.length &&
    cert.stepsOK (cert.tags.length + a) ((cert.hints.drop a).take (b - a))

/-- The clause `empty` is empty and has an id `< u + n`. -/
def Cert.endOK (cert : Cert) (n : Nat) : Bool :=
  Nat.blt cert.empty (cert.tags.length + n) &&
    match cert.db.get D cert.empty with
    | some [] => true
    | _ => false

/-! ## Certificate literals

The certificates are written as strings and turned into terms by the elaborator `lsat_cert%`
(raw natural number literals, nested `List.cons`, the tries built here).  This is only a way to
*write down* a term of type `Cert`: the kernel checks the resulting term like any other, and the
soundness of the checks holds for every `Cert`.

Format: four sections separated by `#`: variables, initial clauses, steps (entries separated by
`,`, numbers by spaces), and the id of the empty clause.  A variable is `n`, `y m u` or
`o m v lo hi i` (variable `x` is the `x`-th entry); an initial clause is the kind (`0..4`:
`lo hi ord tot win`), the arguments of the tag, then the literals; a step is the clause length,
the clause, then the hints. -/

section certElab

open Lean

private def natE (n : Nat) : Expr := mkRawNatLit n

private def natListE (xs : List Nat) : Expr :=
  xs.foldr (fun x e => mkApp3 (mkConst ``List.cons [0]) (mkConst ``Nat) (natE x) e)
    (mkApp (mkConst ``List.nil [0]) (mkConst ``Nat))

private def listE (ty : Expr) (xs : List Expr) : Expr :=
  xs.foldr (fun x e => mkApp3 (mkConst ``List.cons [0]) ty x e) (mkApp (mkConst ``List.nil [0]) ty)

private def nums (s : String) : List Nat :=
  (((s.replace "\n" " ").splitOn " ").filter (· ≠ "")).map String.toNat!

private def varE : List String → Expr
  | ["y", m, u] => mkApp2 (mkConst ``VarTag.y) (natE m.toNat!) (natE u.toNat!)
  | ["o", m, v, lo, hi, i] => mkAppN (mkConst ``VarTag.o) (#[m, v, lo, hi, i].map (natE ·.toNat!))
  | _ => mkConst ``VarTag.none

private def arity : Nat → Nat
  | 0 => 1 | 1 => 1 | 2 => 2 | 3 => 8 | _ => 2

private def ctagName : Nat → Name
  | 0 => ``CTag.lo | 1 => ``CTag.hi | 2 => ``CTag.ord | 3 => ``CTag.tot | _ => ``CTag.win

/-- The trie holding `xs[base + stride * j]` at key `j` (`Trie.get`'s key layout). -/
private partial def trieE (ty : Expr) (xs : Array Expr) (base stride : Nat) : Expr :=
  if base ≥ xs.size then mkApp (mkConst ``Trie.leaf) ty
  else mkApp4 (mkConst ``Trie.node) ty (mkApp2 (mkConst ``Option.some [0]) ty xs[base]!)
    (trieE ty xs (base + stride) (2 * stride)) (trieE ty xs (base + 2 * stride) (2 * stride))

/-- Elaborate a certificate string into a term of type `Cert`. -/
elab "lsat_cert% " s:str : term => do
  let secs := s.getString.splitOn "#"
  let entries (i : Nat) : List String :=
    ((secs.getD i "").splitOn ",").filter (fun e => e.any (fun ch => ch != ' ' && ch != '\n'))
  let vt := (entries 0).map (fun e => varE (((e.replace "\n" " ").splitOn " ").filter (· ≠ "")))
  let natL := mkApp (mkConst ``List [0]) (mkConst ``Nat)
  let init := (entries 1).map fun e =>
    let xs := nums e
    let k := xs.headD 0
    let args := (xs.drop 1).take (arity k)
    (mkAppN (mkConst (ctagName k)) (args.map natE).toArray, natListE (xs.drop (1 + arity k)))
  let steps := (entries 2).map fun e =>
    let xs := nums e
    let n := xs.headD 0
    (natListE ((xs.drop 1).take n), natListE (xs.drop (1 + n)))
  let empty := (nums (secs.getD 3 "")).headD 0
  let clauses := (init.map (·.2) ++ steps.map (·.1)).toArray
  let vtT := mkConst ``VarTag
  return mkAppN (mkConst ``Cert.mk) #[trieE vtT vt.toArray 0 1, trieE natL clauses 0 1,
    listE (mkConst ``CTag) (init.map (·.1)), listE natL (steps.map (·.2)), natE empty]

end certElab

end LSAT
end Folds
