/-! ## The 3-prefix iff for `N ≤ 50`, and for all `N` modulo the residual -/

/-- **`Good3 N` for every `N ≤ 50`, `N ≠ 7`.** -/
theorem good3_le_50 : ∀ N, N ≤ 50 → N ≠ 7 → Good3 N := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro hN h7
    by_cases h30 : N ≤ 30
    · exact good3_le_30 h30 h7
    have IH : ∀ q, q < N → q ≠ 7 → Good3 q := fun q hq h7' => ih q hq (by omega) h7'
    have h31 : 31 ≤ N := by omega
    interval_cases N
    exacts [good3_of_cov IH cov_31, good3_of_cov IH cov_32, good3_of_cov IH cov_33, good3_of_cov IH cov_34, good3_of_cov IH cov_35, good3_of_cov IH cov_36, good3_of_cov IH cov_37, good3_of_cov IH cov_38, good3_of_cov IH cov_39, good3_of_cov IH cov_40, good3_of_cov IH cov_41, good3_of_cov IH cov_42, good3_of_cov IH cov_43, good3_of_cov IH cov_44, good3_of_cov IH cov_45, good3_of_cov IH cov_46, good3_of_cov IH cov_47, good3_of_cov IH cov_48, good3_of_cov IH cov_49, good3_of_cov IH cov_50]

/-- **The 3-prefix analogue of Conjecture C for every `N ≤ 50`, `N ≠ 7`**: a valid 3-prefix
is live iff its set is not one of the dead 3-sets `Dead3`. -/
theorem extends3_iff_le_50 {N x y z : Nat} (hN : N ≤ 50) (h7 : N ≠ 7)
    (hx : 1 ≤ x ∧ x ≤ N) (hy : 1 ≤ y ∧ y ≤ N) (hz : 1 ≤ z ∧ z ≤ N) (hxy : x ≠ y)
    (hxz : x ≠ z) (hyz : y ≠ z) (hv : SemiSymmetric N [x, y, z]) :
    Extends N [x, y, z] ↔ ¬ Dead3 N {x, y, z} :=
  extends3_iff_of_good3 (good3_le_50 N hN h7) hx hy hz hxy hxz hyz hv

/-- **The 3-prefix analogue of Conjecture C for all `N ≠ 7`, modulo the residual**: if for
every `N > 50` the valid non-dead triples not settled by `Covered3S` (Theorem G in closed
form, Theorem G after at most two explicit steps, a transfer through a copy from a smaller
strip, or the same for the mirror image) are co-reachable, then for every `N ≠ 7` a valid
3-prefix is live iff its set is not dead. -/
theorem extends3_iff_of_residual (hres : ∀ N, 50 < N → Residual3 N) {N x y z : Nat}
    (h7 : N ≠ 7) (hx : 1 ≤ x ∧ x ≤ N) (hy : 1 ≤ y ∧ y ≤ N) (hz : 1 ≤ z ∧ z ≤ N)
    (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z) (hv : SemiSymmetric N [x, y, z]) :
    Extends N [x, y, z] ↔ ¬ Dead3 N {x, y, z} :=
  extends3_iff_of_good3 (good3_of_residual good3_le_50 hres N h7) hx hy hz hxy hxz hyz hv

