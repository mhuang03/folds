/-- **The covering statement for `65 ≤ N ≤ 300`.** -/
theorem coverAt_le : ∀ N, 65 ≤ N → N ≤ 300 → CoverAt E7 N :=
  fun N h1 h2 => coverAt_of_mixed h1 (mixedCover_le N h1 h2)

/-- **Conjecture C for `N ≤ 300`, unconditionally**: every non-dead pair of `[N]` is
co-reachable. -/
theorem coReach_le_300 :
    ∀ N, N ≤ 300 → ∀ u v, 1 ≤ u → u < v → v ≤ N → deadB N u v = false → CoReach N {u, v} :=
  coReach_of_coverAt coReach_E7 300 fun N h13 hN => by
    by_cases h : N ≤ 64
    · exact coverAt_of_coverB (coverB_small N h13 h)
    · exact coverAt_le N (by omega) hN

/-- **Conjecture C for valid 2-prefixes, `N ≤ 300`**: a valid prefix `[m₁, m₂]` is live iff
`{m₁, m₂}` is not dead. -/
theorem extends_iff_not_dead_le_300 {N m₁ m₂ : Nat} (hN : N ≤ 300)
    (h1 : 1 ≤ m₁ ∧ m₁ ≤ N) (h2 : 1 ≤ m₂ ∧ m₂ ≤ N) (h12 : m₁ ≠ m₂)
    (hval : SemiSymmetric N [m₁, m₂]) :
    Extends N [m₁, m₂] ↔ deadB N (min m₁ m₂) (max m₁ m₂) = false :=
  extends_iff_of_coReach (coReach_le_300 N hN) h1 h2 h12 hval

/-- **Conjecture C for all `N`, modulo the mixed-parity statement for `N > 300`.** -/
theorem coReach_of_mixed_large (h : ∀ N, 300 < N → MixedCover N) :
    ∀ N u v, 1 ≤ u → u < v → v ≤ N → deadB N u v = false → CoReach N {u, v} :=
  coReach_of_cover_large fun N hN => by
    by_cases h' : N ≤ 300
    · exact coverAt_le N hN h'
    · exact coverAt_of_mixed hN (h N (by omega))

/-- **Conjecture C (2-prefixes) for all `N`, modulo `MixedCover N` for `N > 300`**: a valid
prefix `[m₁, m₂]` is live iff `{m₁, m₂}` is not dead. -/
theorem conjectureC_of_mixed (h : ∀ N, 300 < N → MixedCover N) {N m₁ m₂ : Nat}
    (h1 : 1 ≤ m₁ ∧ m₁ ≤ N) (h2 : 1 ≤ m₂ ∧ m₂ ≤ N) (h12 : m₁ ≠ m₂)
    (hval : SemiSymmetric N [m₁, m₂]) :
    Extends N [m₁, m₂] ↔ deadB N (min m₁ m₂) (max m₁ m₂) = false :=
  extends_iff_of_coReach (coReach_of_mixed_large h N) h1 h2 h12 hval

/-- **Conjecture C (2-prefixes) for all `N`, modulo the arithmetic statement `ArithCover N`
for `N > 300`** (a statement about floors only, verified for `65 ≤ N ≤ 3000`). -/
theorem conjectureC_of_arith (hA : ∀ N, 300 < N → ArithCover N) {N m₁ m₂ : Nat}
    (h1 : 1 ≤ m₁ ∧ m₁ ≤ N) (h2 : 1 ≤ m₂ ∧ m₂ ≤ N) (h12 : m₁ ≠ m₂)
    (hval : SemiSymmetric N [m₁, m₂]) :
    Extends N [m₁, m₂] ↔ deadB N (min m₁ m₂) (max m₁ m₂) = false :=
  conjectureC_of_mixed (fun N hN => mixedCover_of_arith (by omega) (hA N hN)) h1 h2 h12 hval

