import Folds.Live7

/-!
# Live pairs, part 8: the covering statement beyond `N = 64`

`experiments/live8/PROOFS.txt`.

* `samePar_settled`: every same-parity pair is settled (all `N ≥ 65`), and
  `coverAt_of_mixed`: `CoverAt E7 N` follows from `MixedCover N`, the statement for the
  mixed-parity wide pairs only.
* `mixedB`, `mixedCover_of_B`: a certificate checker for `MixedCover N`;
  `mixedCover_le`: `MixedCover N` for `65 ≤ N ≤ 300` (one `decide` per `N`).
* **`coReach_le_300`, `extends_iff_not_dead_le_300`: Conjecture C for 2-prefixes, `N ≤ 300`.**
* `slide`, `settled_directZ`, `settled_directZ_region`, `settled_evenEven`: sliding-window
  (rotation) lemmas and two infinite families of mixed pairs settled for all `N`.
* `dirOK`, `dirAny`, `settled7_of_dirAny`: exact direct certificates;
  `settled7_one_v` and the special pairs with `u ≤ 3` (all `N ≥ 65`);
  `mixedCover_of_arith`: `MixedCover N` from the purely arithmetic statement `ArithCover N`.
* `conjectureC_of_mixed`, `conjectureC_of_arith`: Conjecture C for all `N`, modulo
  `MixedCover N`, resp. `ArithCover N`, for `N > 300` (`ArithCover N` is verified numerically
  for `65 ≤ N ≤ 3000`).
-/

namespace Folds
namespace Live8

open Live2 Live4 Adjacent Live5 Live6 Live7

/-! ## Constructors for `Settled7` -/

theorem settled7_beatty {N p h a b u v : Nat} (hp : 1 ≤ p) (hh : h + 2 * p ≤ N + 1) (h1 : h ≤ 1)
    (ha : 1 ≤ a) (hab : a < b) (hb : b ≤ p) (hd : deadB p a b = false)
    (e1 : beatty N p h a = u) (e2 : beatty N p h b = v) : Settled7 N u v :=
  Or.inl (Or.inr (Or.inr (Or.inl ⟨p, h, a, b, hp, hh, h1, ha, hab, hb, hd, e1, e2⟩)))

theorem settled7_z {N p a b u v : Nat} (hp : 1 ≤ p) (hpN : 2 * p ≤ N)
    (ha : 1 ≤ a) (hab : a < b) (hb : b ≤ p) (hd : deadB p a b = false)
    (e1 : zF N p a = u) (e2 : zF N p b = v) : Settled7 N u v :=
  Or.inr ⟨p, a, b, hp, hpN, ha, hab, hb, hd, e1, e2⟩

theorem settled7_inward {N u v : Nat} (h : v ≤ 2 * u + 1 ∨ 2 * v ≤ N + u + 2) :
    Settled7 N u v :=
  Or.inl (Or.inl h)

theorem settled7_one {N : Nat} (h1 : N % 2 = 1) (h7 : N ≠ 7) : Settled7 N 1 N :=
  Or.inl (Or.inr (Or.inl ⟨rfl, rfl, h1, h7⟩))

theorem deadB_false_of_lt {p a b : Nat} (h : 2 ≤ a) : deadB p a b = false := by
  unfold deadB
  have : (a == 1) = false := by simp; omega
  rw [this, Bool.false_and, Bool.false_and]

theorem deadB_false_of_ne {p a b : Nat} (h : b ≠ p) : deadB p a b = false := by
  unfold deadB
  have : (b == p) = false := by simp [h]
  rw [this, Bool.and_false, Bool.false_and]

theorem deadB_false_odd {p a b : Nat} (hodd : p % 2 = 1) (h7 : p ≠ 7) : deadB p a b = false := by
  unfold deadB
  have h1 : (p % 2 == 0) = false := by simp; omega
  have h2 : (p == 7) = false := by simp [h7]
  rw [h1, h2, Bool.false_and, Bool.false_or, Bool.and_false]

/-! ## Slope-2 copies -/

theorem beatty_even {n r : Nat} (hn : 1 ≤ n) : beatty (2 * n) n 0 r = 2 * r := by
  unfold beatty
  rw [Nat.sub_zero, show r * (2 * n) = 2 * r * n by ring]
  exact Nat.mul_div_cancel _ (by omega)

theorem beatty_odd {n r : Nat} (hn : 1 ≤ n) (hr : 1 ≤ r) : beatty (2 * n) n 1 r = 2 * r - 1 := by
  obtain ⟨k, rfl⟩ : ∃ k, r = k + 1 := ⟨r - 1, by omega⟩
  unfold beatty
  rw [show 2 * (k + 1) - 1 = 2 * k + 1 by omega]
  have e : (k + 1) * (2 * n) = (2 * k + 1) * n + n := by ring
  have e2 : (2 * k + 1 + 1) * n = (2 * k + 1) * n + n := by ring
  apply Nat.div_eq_of_lt_le <;> omega

theorem beatty_odd' {n r : Nat} (hr : 1 ≤ r) (hrn : r ≤ n + 1) :
    beatty (2 * n + 1) (n + 1) 0 r = 2 * r - 1 := by
  unfold beatty
  rw [Nat.sub_zero]
  apply Nat.div_eq_of_lt_le
  · have : (2 * r - 1) * (n + 1) + (n + 1 - r) = r * (2 * n + 1) := by
      rcases r with _ | r
      · omega
      · rw [show 2 * (r + 1) - 1 = 2 * r + 1 by omega, show n + 1 - (r + 1) = n - r by omega]
        zify [show r ≤ n by omega]
        ring
    omega
  · have : (2 * r - 1 + 1) * (n + 1) = r * (2 * n + 1) + r := by
      rw [show 2 * r - 1 + 1 = 2 * r by omega]; ring
    omega

theorem zF_even' {n k : Nat} (hk : k ≤ n) : zF (2 * n + 1) n k = 2 * k := by
  unfold zF beatty
  rw [Nat.sub_zero]
  apply Nat.div_eq_of_lt_le
  · have : 2 * k * (n + 1) + k = k * (2 * n + 1 + 2) := by ring
    omega
  · have : (2 * k + 1) * (n + 1) = k * (2 * n + 1 + 2) + (n + 1 - k) := by
      zify [(by omega : k ≤ n + 1)]; ring
    omega

/-- The corner `(2, N)` for `N ≡ 0 mod 4`: the image of `(1, p)` under `X(N, p, 0)`,
`p = N/2 - 1` odd. -/
theorem settled7_two_N {N : Nat} (hN : 20 ≤ N) (h4 : N % 4 = 0) : Settled7 N 2 N := by
  obtain ⟨n, rfl⟩ : ∃ n, N = 2 * n + 2 := ⟨N / 2 - 1, by omega⟩
  refine settled7_beatty (p := n) (h := 0) (a := 1) (b := n) (by omega) (by omega) (by omega)
    le_rfl (by omega) le_rfl (deadB_false_odd (by omega) (by omega)) ?_ ?_
  · unfold beatty
    rw [Nat.sub_zero, Nat.one_mul]
    exact Nat.div_eq_of_lt_le (by omega) (by omega)
  · unfold beatty
    rw [Nat.sub_zero, Nat.mul_comm]
    exact Nat.mul_div_cancel _ (by omega)

/-- The corner `(2, N - 1)` for `N ≡ 1 mod 4`: the image of `(1, p)` under `Z(N, p)`,
`p = (N - 3)/2` odd. -/
theorem settled7_two_N1 {N : Nat} (hN : 21 ≤ N) (h4 : N % 4 = 1) : Settled7 N 2 (N - 1) := by
  obtain ⟨p, rfl⟩ : ∃ p, N = 2 * p + 3 := ⟨(N - 3) / 2, by omega⟩
  obtain ⟨e1, e2⟩ := zF_corner (N := 2 * p + 3) (p := p) (c := 2) (by omega) (by omega)
  refine settled7_z (p := p) (a := 1) (b := p) (by omega) (by omega) le_rfl (by omega) le_rfl
    (deadB_false_odd (by omega) (by omega)) e1 ?_
  rw [e2]; omega

/-- **Same-parity pairs are settled** (`N ≥ 65`): by the slope-2 copies `X(N, n, h)` (`N = 2n`),
`X(N, n + 1, 0)` and `Z(N, n)` (`N = 2n + 1`), or the corners. -/
theorem samePar_settled {N u v : Nat} (hN : 65 ≤ N) (hu : 1 ≤ u) (huv : u < v) (hv : v ≤ N)
    (hpar : u % 2 = v % 2) (hd : deadB N u v = false) :
    Settled7 N u v ∨ Settled7 N (N + 1 - v) (N + 1 - u) := by
  rcases Nat.even_or_odd' N with ⟨n, hn | hn⟩
  · subst hn
    rcases Nat.even_or_odd' u with ⟨a, ha | ha⟩
    · -- both even: X(2n, n, 0)
      obtain ⟨b, rfl⟩ : ∃ b, v = 2 * b := ⟨v / 2, by omega⟩
      subst ha
      by_cases hc : a = 1 ∧ b = n
      · -- (2, N): dead preimage iff n even
        rw [hc.1, hc.2]
        by_cases h4 : n % 2 = 0
        · exact Or.inl (settled7_two_N (by omega) (by omega))
        · exact Or.inl (settled7_beatty (p := n) (h := 0) (a := 1) (b := n) (by omega) (by omega)
            (by omega) le_rfl (by omega) le_rfl (deadB_false_odd (by omega) (by omega))
            (beatty_even (by omega)) (beatty_even (by omega)))
      · refine Or.inl (settled7_beatty (p := n) (h := 0) (a := a) (b := b) (by omega) (by omega)
          (by omega) (by omega) (by omega) (by omega) ?_ (beatty_even (by omega))
          (beatty_even (by omega)))
        unfold deadB; simp only [Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq]; omega
    · -- both odd: X(2n, n, 1)
      obtain ⟨b, hb⟩ : ∃ b, v = 2 * b + 1 := ⟨v / 2, by omega⟩
      subst ha hb
      by_cases hc : a = 0 ∧ b + 1 = n
      · -- (1, N - 1): its mirror is (2, N)
        right
        rw [show 2 * n + 1 - (2 * b + 1) = 2 by omega, show 2 * n + 1 - (2 * a + 1) = 2 * n by omega]
        by_cases h4 : n % 2 = 0
        · exact settled7_two_N (by omega) (by omega)
        · exact settled7_beatty (p := n) (h := 0) (a := 1) (b := n) (by omega) (by omega)
            (by omega) le_rfl (by omega) le_rfl (deadB_false_odd (by omega) (by omega))
            (beatty_even (by omega)) (beatty_even (by omega))
      · refine Or.inl (settled7_beatty (p := n) (h := 1) (a := a + 1) (b := b + 1) (by omega)
          (by omega) (by omega) (by omega) (by omega) (by omega) ?_ ?_ ?_)
        · unfold deadB; simp only [Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq]; omega
        · rw [beatty_odd (by omega) (by omega)]; omega
        · rw [beatty_odd (by omega) (by omega)]; omega
  · subst hn
    rcases Nat.even_or_odd' u with ⟨a, ha | ha⟩
    · -- both even: Z(2n+1, n)
      obtain ⟨b, rfl⟩ : ∃ b, v = 2 * b := ⟨v / 2, by omega⟩
      subst ha
      by_cases hc : a = 1 ∧ b = n
      · rw [hc.1, hc.2]
        by_cases h4 : n % 2 = 0
        · exact Or.inl (by
            have := settled7_two_N1 (N := 2 * n + 1) (by omega) (by omega)
            rwa [show 2 * n + 1 - 1 = 2 * n by omega] at this)
        · exact Or.inl (settled7_z (p := n) (a := 1) (b := n) (by omega) (by omega) le_rfl
            (by omega) le_rfl (deadB_false_odd (by omega) (by omega)) (zF_even' (by omega))
            (zF_even' le_rfl))
      · refine Or.inl (settled7_z (p := n) (a := a) (b := b) (by omega) (by omega) (by omega)
          (by omega) (by omega) ?_ (zF_even' (by omega)) (zF_even' (by omega)))
        unfold deadB; simp only [Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq]; omega
    · -- both odd: X(2n+1, n+1, 0)
      obtain ⟨b, hb⟩ : ∃ b, v = 2 * b + 1 := ⟨v / 2, by omega⟩
      subst ha hb
      by_cases hc : a = 0 ∧ b = n
      · rw [hc.1, hc.2]
        exact Or.inl (by simpa using settled7_one (N := 2 * n + 1) (by omega) (by omega))
      · refine Or.inl (settled7_beatty (p := n + 1) (h := 0) (a := a + 1) (b := b + 1) (by omega)
          (by omega) (by omega) (by omega) (by omega) (by omega) ?_ ?_ ?_)
        · unfold deadB; simp only [Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq]; omega
        · rw [beatty_odd' (by omega) (by omega)]; omega
        · rw [beatty_odd' (by omega) (by omega)]; omega

/-! ## Reduction to the mixed-parity wide pairs -/

/-- The covering statement for the **mixed-parity wide pairs** (`u + v` odd, Theorem G fails,
`u + v ≤ N + 1`): each is settled, or its mirror is. -/
def MixedCover (N : Nat) : Prop :=
  ∀ u v, 1 ≤ u → u < v → u + v ≤ N + 1 → (u + v) % 2 = 1 → 2 * u + 2 ≤ v →
    N + u + 3 ≤ 2 * v → deadB N u v = false →
      Settled7 N u v ∨ Settled7 N (N + 1 - v) (N + 1 - u)

theorem deadB_mirror {N u v : Nat} (_hu : 1 ≤ u) (huv : u < v) (hv : v ≤ N)
    (hd : deadB N u v = false) : deadB N (N + 1 - v) (N + 1 - u) = false := by
  unfold deadB at hd ⊢
  simp only [Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq] at hd ⊢
  rcases hd with (hd | hd) | hd
  · left; right; omega
  · left; left; omega
  · right; exact hd

/-- **`CoverAt E7 N` from the mixed-parity statement** (`N ≥ 65`): Theorem G, the same-parity
pairs (`samePar_settled`) and the mirror take care of everything else. -/
theorem coverAt_of_mixed {N : Nat} (hN : 65 ≤ N) (h : MixedCover N) : CoverAt E7 N := by
  intro u v hu huv hv hd
  by_cases hin : v ≤ 2 * u + 1 ∨ 2 * v ≤ N + u + 2
  · exact Or.inl (settled7_inward hin)
  by_cases hpar : u % 2 = v % 2
  · rcases samePar_settled hN hu huv hv hpar hd with h1 | h1
    · exact Or.inl h1
    · exact Or.inr (Or.inl h1)
  by_cases hs : u + v ≤ N + 1
  · rcases h u v hu huv hs (by omega) (by omega) (by omega) hd with h1 | h1
    · exact Or.inl h1
    · exact Or.inr (Or.inl h1)
  · -- the mirror pair
    have hd' := deadB_mirror hu huv hv hd
    by_cases hin' : N + 1 - u ≤ 2 * (N + 1 - v) + 1 ∨ 2 * (N + 1 - u) ≤ N + (N + 1 - v) + 2
    · exact Or.inr (Or.inl (settled7_inward hin'))
    · rcases h (N + 1 - v) (N + 1 - u) (by omega) (by omega) (by omega) (by omega) (by omega)
        (by omega) hd' with h1 | h1
      · exact Or.inr (Or.inl h1)
      · left
        rwa [show N + 1 - (N + 1 - u) = u by omega, show N + 1 - (N + 1 - v) = v by omega] at h1

/-- **Conjecture C for all `N`, modulo the mixed-parity statement for `N ≥ 65`.** -/
theorem coReach_of_mixed (h : ∀ N, 65 ≤ N → MixedCover N) :
    ∀ N u v, 1 ≤ u → u < v → v ≤ N → deadB N u v = false → CoReach N {u, v} :=
  coReach_of_cover_large fun N hN => coverAt_of_mixed hN (h N hN)

/-! ## A certificate checker for the mixed-parity wide pairs at one `N`

A certificate `c` for a pair `(u, v)` packs an orientation `o = c % 2` (the pair itself or its
mirror), a family `f = (c / 2) % 4` (`X(N, p, 0)`, `X(N, p, 1)`, `Z(N, p)`, or a fallback to the
full search `settled7B`) and `p = c / 8`.  The indices are the candidate indices `candB`, `candZ`
of Live7; the images are re-checked, so soundness is immediate.  The certificates of one `u`
are packed into one `Nat` in base `2^12`. -/

def beattyW (N p h x y : Nat) : Bool :=
  decide (1 ≤ p) && decide (h + 2 * p ≤ N + 1) && decide (1 ≤ candB N p h x) &&
    decide (candB N p h x < candB N p h y) && decide (candB N p h y ≤ p) &&
    !deadB p (candB N p h x) (candB N p h y) &&
    beatty N p h (candB N p h x) == x && beatty N p h (candB N p h y) == y

def zW (N p x y : Nat) : Bool :=
  decide (1 ≤ p) && decide (2 * p ≤ N) && decide (1 ≤ candZ N p x) &&
    decide (candZ N p x < candZ N p y) && decide (candZ N p y ≤ p) &&
    !deadB p (candZ N p x) (candZ N p y) &&
    zF N p (candZ N p x) == x && zF N p (candZ N p y) == y

theorem settled7_of_beattyW {N p h x y : Nat} (h1 : h ≤ 1) (hw : beattyW N p h x y = true) :
    Settled7 N x y := by
  unfold beattyW at hw
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true', beq_iff_eq] at hw
  obtain ⟨⟨⟨⟨⟨⟨⟨hp, hh⟩, ha⟩, hab⟩, hb⟩, hd⟩, e1⟩, e2⟩ := hw
  exact settled7_beatty hp hh h1 ha hab hb hd e1 e2

theorem settled7_of_zW {N p x y : Nat} (hw : zW N p x y = true) : Settled7 N x y := by
  unfold zW at hw
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true', beq_iff_eq] at hw
  obtain ⟨⟨⟨⟨⟨⟨⟨hp, hh⟩, ha⟩, hab⟩, hb⟩, hd⟩, e1⟩, e2⟩ := hw
  exact settled7_z hp hh ha hab hb hd e1 e2

/-- Check a witness for the pair `x < y`: family `f` (`0, 1`: `X(N, p, f)`; otherwise `Z(N, p)`). -/
def chkXY (N x y f p : Nat) : Bool :=
  if f = 0 then beattyW N p 0 x y else if f = 1 then beattyW N p 1 x y else zW N p x y

theorem chkXY_sound {N x y f p : Nat} (h : chkXY N x y f p = true) : Settled7 N x y := by
  unfold chkXY at h
  split_ifs at h
  · exact settled7_of_beattyW (by omega) h
  · exact settled7_of_beattyW le_rfl h
  · exact settled7_of_zW h

/-- Check one certificate for the pair `(u, v)`. -/
def chkCert (N u v c : Nat) : Bool :=
  if (c / 2) % 4 = 3 then settled7B N u v || settled7B N (N + 1 - v) (N + 1 - u)
  else if c % 2 = 0 then chkXY N u v ((c / 2) % 4) (c / 8)
  else chkXY N (N + 1 - v) (N + 1 - u) ((c / 2) % 4) (c / 8)

theorem chkCert_sound {N u v c : Nat} (h : chkCert N u v c = true) :
    Settled7 N u v ∨ Settled7 N (N + 1 - v) (N + 1 - u) := by
  unfold chkCert at h
  split_ifs at h
  · simp only [Bool.or_eq_true] at h
    rcases h with h | h
    · exact Or.inl (settled7_of_B h)
    · exact Or.inr (settled7_of_B h)
  · exact Or.inl (chkXY_sound h)
  · exact Or.inr (chkXY_sound h)


/-- Check the pairs `(u, w)`, `v ≤ w < v + k`, consuming one certificate (a base `2^12` place
of `c`) for each `w` with `u + w` odd. -/
def chkU (N u : Nat) : Nat → Nat → Nat → Bool
  | 0, _, _ => true
  | k + 1, v, c =>
    if (u + v) % 2 = 1 then
      (deadB N u v || chkCert N u v (c % 4096)) && chkU N u k (v + 1) (c / 4096)
    else chkU N u k (v + 1) c

theorem chkU_sound {N u : Nat} : ∀ k v c, chkU N u k v c = true → ∀ w, v ≤ w → w < v + k →
    (u + w) % 2 = 1 → deadB N u w = false →
      Settled7 N u w ∨ Settled7 N (N + 1 - w) (N + 1 - u) := by
  intro k
  induction k with
  | zero => intro v c _ w h1 h2; omega
  | succ k ih =>
    intro v c h w h1 h2 hw hd
    unfold chkU at h
    split_ifs at h with hv
    · simp only [Bool.and_eq_true, Bool.or_eq_true] at h
      obtain ⟨h3, h4⟩ := h
      by_cases hwv : w = v
      · subst hwv
        rcases h3 with h3 | h3
        · rw [hd] at h3; exact absurd h3 (by simp)
        · exact chkCert_sound h3
      · exact ih (v + 1) _ h4 w (by omega) (by omega) hw hd
    · by_cases hwv : w = v
      · subst hwv; omega
      · exact ih (v + 1) _ h w (by omega) (by omega) hw hd

/-- The smallest `v` of a wide pair `(u, v)`. -/
def vLo (N u : Nat) : Nat := max (2 * u + 2) ((N + u + 4) / 2)

/-- Check all `u ≥ u₀`, one packed certificate per `u`. -/
def goU (N : Nat) : Nat → List Nat → Bool
  | u, [] => decide (N < 3 * u + 1)
  | u, c :: cs => chkU N u (N + 2 - u - vLo N u) (vLo N u) c && goU N (u + 1) cs

theorem goU_sound {N : Nat} : ∀ cs u₀, goU N u₀ cs = true → ∀ u v, u₀ ≤ u → u < v →
    u + v ≤ N + 1 → (u + v) % 2 = 1 → 2 * u + 2 ≤ v → N + u + 3 ≤ 2 * v →
    deadB N u v = false → Settled7 N u v ∨ Settled7 N (N + 1 - v) (N + 1 - u) := by
  intro cs
  induction cs with
  | nil =>
    intro u₀ h u v hu _ hs _ h1 h2 _
    unfold goU at h
    simp only [decide_eq_true_eq] at h
    omega
  | cons c cs ih =>
    intro u₀ h u v hu huv hs hp h1 h2 hd
    unfold goU at h
    simp only [Bool.and_eq_true] at h
    by_cases hu' : u = u₀
    · subst hu'
      exact chkU_sound _ _ _ h.1 v (by unfold vLo; omega) (by unfold vLo; omega) hp hd
    · exact ih (u₀ + 1) h.2 u v (by omega) huv hs hp h1 h2 hd

/-- The certificate check at one `N`. -/
def mixedB (N : Nat) (cs : List Nat) : Bool := goU N 1 cs

theorem mixedCover_of_B {N : Nat} {cs : List Nat} (h : mixedB N cs = true) : MixedCover N :=
  fun u v hu huv hs hp h1 h2 hd => goU_sound cs 1 h u v hu huv hs hp h1 h2 hd

/-! ## Sliding windows: a rotation lemma

For `s₁ ≤ s ≤ s₂` the windows `[sR + β, sR + β + s - 1]` overlap or abut as soon as `R ≤ s₁`,
so their union is `[s₁R + β, s₂R + β + s₂ - 1]`; if that has length `≥ K` it contains a multiple
of `K`. -/

theorem slide {K R β s₁ s₂ : Nat} (hK : 0 < K) (hR : R ≤ s₁) (h12 : s₁ ≤ s₂)
    (hlen : s₁ * R + β + K ≤ s₂ * R + β + s₂) :
    ∃ s c, s₁ ≤ s ∧ s ≤ s₂ ∧ s * R + β ≤ c * K ∧ c * K + 1 ≤ s * R + β + s := by
  set c := (s₁ * R + β + K - 1) / K with hc
  have hc1 : s₁ * R + β ≤ c * K := by
    have := Nat.lt_mul_div_succ (s₁ * R + β + K - 1) hK
    rw [← hc] at this
    have e : K * (c + 1) = c * K + K := by ring
    omega
  have hc2 : c * K ≤ s₁ * R + β + K - 1 := by
    have := Nat.div_mul_le_self (s₁ * R + β + K - 1) K
    rw [← hc] at this
    exact this
  rcases Nat.eq_zero_or_pos R with hR0 | hRp
  · subst hR0
    refine ⟨s₂, c, h12, le_rfl, ?_, ?_⟩ <;> simp only [Nat.mul_zero, Nat.zero_add] at * <;> omega
  · set s := min s₂ ((c * K - β) / R) with hs
    have hsR : s * R ≤ c * K - β := by
      calc s * R ≤ (c * K - β) / R * R := Nat.mul_le_mul_right _ (min_le_right _ _)
        _ ≤ c * K - β := Nat.div_mul_le_self _ _
    have hs1 : s₁ ≤ s := by
      refine le_min h12 ?_
      rw [Nat.le_div_iff_mul_le hRp]
      omega
    refine ⟨s, c, hs1, min_le_left _ _, by omega, ?_⟩
    by_cases hlt : s < s₂
    · -- then s = ⌊(cK - β)/R⌋, so (s + 1) R + β > cK
      have hs' : s = (c * K - β) / R := by
        rcases min_cases s₂ ((c * K - β) / R) with ⟨h1, _⟩ | ⟨h1, _⟩
        · rw [← hs] at h1; omega
        · rw [← hs] at h1; exact h1
      have := Nat.lt_mul_div_succ (c * K - β) hRp
      rw [← hs'] at this
      have e : R * (s + 1) = s * R + R := by ring
      have : R ≤ s := le_trans hR hs1
      omega
    · have hss : s = s₂ := le_antisymm (min_le_left _ _) (by omega)
      rw [hss]
      have : s₁ * R ≤ s₂ * R := Nat.mul_le_mul_right _ h12
      omega

/-! ## The direct rotation lemma for `Z(N, q - 1)`

Fix the index `a` of `u`; for `q` with `qu ≤ aM ≤ qu + q - 1` (`M = N + 2`) the element `u` is
`zF N (q-1) a`, and `v = N + 1 - u'` is an element of `Z(N, q - 1)` iff some `cM` lies in
`[qu' + 1, qu' + q]`.  These windows slide by `u'` as `q` increases. -/

theorem settled_directZ {N u u' a s₁ s₂ : Nat} (hu : 1 ≤ u) (ha : 2 ≤ a) (huu : u + u' ≤ N)
    (hs₁ : 2 ≤ s₁) (hR : u' ≤ s₁) (h12 : s₁ ≤ s₂) (hs₂ : 2 * s₂ ≤ N + 2)
    (hI1 : s₂ * u ≤ a * (N + 2)) (hI2 : a * (N + 2) + 1 ≤ s₁ * (u + 1))
    (hlen : s₁ * u' + 1 + (N + 2) ≤ s₂ * u' + 1 + s₂) : Settled7 N u (N + 1 - u') := by
  obtain ⟨s, c, hs1, hs2, hc1, hc2⟩ := slide (K := N + 2) (by omega) hR h12 hlen
  -- q = s, p = s - 1, b = s - c
  have hsu : s * u ≤ a * (N + 2) := le_trans (Nat.mul_le_mul_right _ hs2) hI1
  have hsu2 : a * (N + 2) + 1 ≤ s * (u + 1) := le_trans hI2 (Nat.mul_le_mul_right _ hs1)
  have hc0 : 1 ≤ c := by
    rcases Nat.eq_zero_or_pos c with h | h
    · rw [h, Nat.zero_mul] at hc1; omega
    · exact h
  -- a + c < s
  have hac : a + c < s := by
    by_contra hcon
    push Not at hcon
    have h1 : s * (N + 2) ≤ (a + c) * (N + 2) := Nat.mul_le_mul_right _ hcon
    have h2 : s * (u + u' + 2) ≤ s * (N + 2) := Nat.mul_le_mul_left _ (by omega)
    have e1 : (a + c) * (N + 2) = a * (N + 2) + c * (N + 2) := by ring
    have e2 : s * (u + u' + 2) = s * (u + 1) + s * u' + s := by ring
    omega
  have hp : s - 1 + 1 = s := by omega
  refine settled7_z (p := s - 1) (a := a) (b := s - c) (by omega) (by omega) (by omega)
    (by omega) (by omega) (deadB_false_of_lt ha) ?_ ?_
  · unfold zF beatty
    rw [Nat.sub_zero, hp]
    apply Nat.div_eq_of_lt_le
    · rw [Nat.mul_comm]; exact hsu
    · have : (u + 1) * s = s * (u + 1) := Nat.mul_comm _ _
      omega
  · unfold zF beatty
    rw [Nat.sub_zero, hp]
    have e : (s - c) * (N + 2) + c * (N + 2) = s * (N + 2) := by
      rw [← Nat.add_mul, Nat.sub_add_cancel (by omega)]
    have e2 : s * (N + 2) = s * (N + 1 - u') + s * u' + s := by
      rw [← Nat.mul_add, ← Nat.mul_add_one]; congr 1; omega
    apply Nat.div_eq_of_lt_le
    · rw [Nat.mul_comm (N + 1 - u')]; omega
    · have e3 : (N + 1 - u' + 1) * s = s * (N + 1 - u') + s := by ring
      omega

/-- **An explicit direct region** (`Z(N, q - 1)`, `a = ⌊u/2⌋`).  With `M = N + 2`, `r = u mod 2`:
if `(u - r) M (u + u' + 1) ≥ 2 (u + 1) (M u + 2 u u' + u)` and
`(u M - r M - 2u + 2)(u' + 1) ≥ 2u (u'² + M)`, then `(u, N + 1 - u')` is settled. -/
theorem settled_directZ_region {N u u' : Nat} (hu : 4 ≤ u) (huu' : u ≤ u') (huu : u + u' ≤ N)
    (hA : (u - u % 2) * (N + 2) * (u + u' + 1) ≥ 2 * (u + 1) * ((N + 2) * u + 2 * u * u' + u))
    (hB : (u * (N + 2) - u % 2 * (N + 2) - 2 * u + 2) * (u' + 1) ≥ 2 * u * (u' * u' + (N + 2))) :
    Settled7 N u (N + 1 - u') := by
  set M := N + 2 with hM
  set a := u / 2 with ha
  set T := a * M with hT
  have h2a : 2 * a = u - u % 2 := by omega
  have h2T : 2 * T = (u - u % 2) * M := by rw [hT, ← Nat.mul_assoc, h2a]
  set S2 := T / u with hS2
  set S1 := (T + 1 + u) / (u + 1) with hS1
  -- floor facts
  have fS2 : T < u * (S2 + 1) := Nat.lt_mul_div_succ T (by omega)
  have fS2' : S2 * u ≤ T := Nat.div_mul_le_self T u
  have fS1 : S1 * (u + 1) ≤ T + 1 + u := Nat.div_mul_le_self _ _
  have fS1' : T + 1 + u < (u + 1) * (S1 + 1) := Nat.lt_mul_div_succ _ (by omega)
  have hS2M : 2 * S2 ≤ M := by
    have : 2 * S2 * u ≤ M * u := by
      calc 2 * S2 * u = 2 * (S2 * u) := by ring
        _ ≤ 2 * T := by omega
        _ = (u - u % 2) * M := h2T
        _ ≤ u * M := Nat.mul_le_mul_right _ (by omega)
        _ = M * u := by ring
    exact Nat.le_of_mul_le_mul_right this (by omega)
  -- (i) S1 u' + M ≤ S2 (u' + 1)
  have key1 : S1 * u' + M ≤ S2 * (u' + 1) := by
    have hA' : T * (u + u' + 1) * 2 ≥ 2 * (u + 1) * (M * u + 2 * u * u' + u) := by
      have : 2 * T * (u + u' + 1) = (u - u % 2) * M * (u + u' + 1) := by rw [h2T]
      nlinarith
    -- multiply the goal by u (u + 1)
    have hu1 : 0 < u * (u + 1) := by positivity
    refine Nat.le_of_mul_le_mul_left ?_ hu1
    have g1 : u * (u + 1) * (S1 * u' + M) ≤ u * u' * (T + 1 + u) + u * (u + 1) * M := by
      have e : u * (u + 1) * (S1 * u' + M) = u * u' * (S1 * (u + 1)) + u * (u + 1) * M := by ring
      have := Nat.mul_le_mul_left (u * u') fS1
      omega
    have g2 : (u + 1) * (u' + 1) * (T + 1 - u) ≤ u * (u + 1) * (S2 * (u' + 1)) := by
      have : T + 1 - u ≤ u * S2 := by
        have : u * (S2 + 1) = u * S2 + u := by ring
        omega
      calc (u + 1) * (u' + 1) * (T + 1 - u) ≤ (u + 1) * (u' + 1) * (u * S2) :=
            Nat.mul_le_mul_left _ this
        _ = u * (u + 1) * (S2 * (u' + 1)) := by ring
    have hTu : u ≤ T + 1 := by
      have h2 : 2 ≤ a := by omega
      have : 2 * M ≤ a * M := Nat.mul_le_mul_right _ h2
      omega
    have g3 : u * u' * (T + 1 + u) + u * (u + 1) * M ≤ (u + 1) * (u' + 1) * (T + 1 - u) := by
      zify [hTu] at hA' ⊢
      nlinarith
    omega
  -- (ii) u'² + M ≤ S2 (u' + 1)
  have key2 : u' * u' + M ≤ S2 * (u' + 1) := by
    refine Nat.le_of_mul_le_mul_left ?_ (show 0 < 2 * u by omega)
    have g1 : (2 * T + 2 - 2 * u) * (u' + 1) ≤ 2 * u * (S2 * (u' + 1)) := by
      have : 2 * T + 2 - 2 * u ≤ 2 * (u * S2) := by
        have : u * (S2 + 1) = u * S2 + u := by ring
        omega
      calc (2 * T + 2 - 2 * u) * (u' + 1) ≤ 2 * (u * S2) * (u' + 1) :=
            Nat.mul_le_mul_right _ this
        _ = 2 * u * (S2 * (u' + 1)) := by ring
    have : 2 * T + 2 - 2 * u = u * M - u % 2 * M - 2 * u + 2 := by
      have e : (u - u % 2) * M = u * M - u % 2 * M := Nat.sub_mul _ _ _
      have h2 : 2 ≤ a := by omega
      have : 2 * M ≤ a * M := Nat.mul_le_mul_right _ h2
      rw [← e, ← h2T]; omega
    rw [this] at g1
    exact le_trans hB g1
  -- apply the direct lemma with s₁ = max S1 u', s₂ = S2
  have e2 : S2 * (u' + 1) = S2 * u' + S2 := by ring
  have hmax : max S1 u' * u' + M ≤ S2 * u' + S2 := by
    rcases le_total S1 u' with h | h
    · rw [max_eq_right h]; omega
    · rw [max_eq_left h]; omega
  have h12 : max S1 u' ≤ S2 := by
    by_contra hc
    push Not at hc
    have h3 := Nat.mul_le_mul_right u' (show S2 + 1 ≤ max S1 u' from hc)
    have e3 : (S2 + 1) * u' = S2 * u' + u' := by ring
    omega
  refine settled_directZ (a := a) (s₁ := max S1 u') (s₂ := S2) (by omega) (by omega) huu
    (by omega) (le_max_right _ _) h12 (by omega) fS2' ?_ (by omega)
  calc T + 1 ≤ S1 * (u + 1) := by
        have : (u + 1) * (S1 + 1) = S1 * (u + 1) + u + 1 := by ring
        omega
    _ ≤ max S1 u' * (u + 1) := Nat.mul_le_mul_right _ (le_max_left _ _)

/-! ## An explicit family: `N` even, `u` and `u' = N + 1 - v` even -/

/-- `Z(N, N/2 - 1)` (`N` even) is `{2k : k < N/4} ∪ {2k + 1 : N/4 ≤ k < N/2}`: every pair
(`u` even `< N/2`, `v` odd `> N/2`) with `(u, v) ≠ (2, N - 1)` is settled; `(2, N - 1)` is a
corner of `Z(N, p)`, `p ∈ {N/2 - 1, N/2 - 2}` odd. -/
theorem settled_evenEven {N u v : Nat} (hN : 20 ≤ N) (hNe : N % 2 = 0) (hu : 1 ≤ u)
    (hue : u % 2 = 0) (hve : v % 2 = 1) (hu2 : 2 * u < N) (hv2 : N < 2 * v) (hvN : v + 1 ≤ N) :
    Settled7 N u v := by
  obtain ⟨q, rfl⟩ : ∃ q, N = 2 * q := ⟨N / 2, by omega⟩
  by_cases hc : u = 2 ∧ v = 2 * q - 1
  · obtain ⟨rfl, rfl⟩ := hc
    -- corner: Z(N, p), p odd, 2(p + 1) < N + 2 < 3(p + 1)
    obtain ⟨p, hp1, hp2, hpo, hp7⟩ : ∃ p, p < q ∧ 2 * q + 2 < 3 * (p + 1) ∧ p % 2 = 1 ∧ p ≠ 7 :=
      if h : q % 2 = 0 then ⟨q - 1, by omega, by omega, by omega, by omega⟩
      else ⟨q - 2, by omega, by omega, by omega, by omega⟩
    obtain ⟨e1, e2⟩ := zF_corner (N := 2 * q) (p := p) (c := 2) (by omega) (by omega)
    refine settled7_z (p := p) (a := 1) (b := p) (by omega) (by omega) le_rfl (by omega) le_rfl
      (deadB_false_odd hpo hp7) e1 ?_
    rw [e2]; omega
  · -- the copy Z(2q, q - 1): zF k = 2k + ⌊2k/q⌋
    have hz : ∀ k, k < q → zF (2 * q) (q - 1) k = 2 * k + 2 * k / q := by
      intro k hk
      unfold zF beatty
      rw [Nat.sub_zero, show q - 1 + 1 = q by omega]
      have e : k * (2 * q + 2) = (2 * k) * q + 2 * k := by ring
      rw [e, Nat.add_comm, Nat.add_mul_div_right _ _ (by omega)]
      ring
    have ha := hz (u / 2) (by omega)
    have hb := hz ((v - 1) / 2) (by omega)
    rw [show 2 * (u / 2) / q = 0 from Nat.div_eq_of_lt (by omega)] at ha
    rw [show 2 * ((v - 1) / 2) / q = 1 from Nat.div_eq_of_lt_le (by omega) (by omega)] at hb
    refine settled7_z (p := q - 1) (a := u / 2) (b := (v - 1) / 2) (by omega) (by omega)
      (by omega) (by omega) (by omega) ?_ (by rw [ha]; omega) (by rw [hb]; omega)
    unfold deadB
    simp only [Bool.and_eq_false_iff, beq_eq_false_iff_ne, ne_eq]
    omega

/-! ## Exact direct certificates: an arithmetic form of the covering statement

For a family with modulus `K` (`Z`: `K = N + 2`; `X(N, p, h)`: `K = N`), left value `L`, right
value `R` and offsets `α, β`, the index `a` of the left element fixes the range
`I_a = [S₁, S₂]` of denominators `s`; the windows `[sR + β, sR + β + s - 1]` are contiguous for
`s ≥ R`, and the pair is settled as soon as their union contains a multiple of `K`. -/

theorem slideC {K R β s₁ s₂ c : Nat} (hR : R ≤ s₁) (h12 : s₁ ≤ s₂)
    (hc1 : s₁ * R + β ≤ c * K) (hc2 : c * K + 1 ≤ s₂ * R + β + s₂) :
    ∃ s, s₁ ≤ s ∧ s ≤ s₂ ∧ s * R + β ≤ c * K ∧ c * K + 1 ≤ s * R + β + s := by
  rcases Nat.eq_zero_or_pos R with hR0 | hRp
  · subst hR0
    exact ⟨s₂, h12, le_rfl, by simp only [Nat.mul_zero, Nat.zero_add] at *; omega, hc2⟩
  · set s := min s₂ ((c * K - β) / R) with hs
    have hsR : s * R ≤ c * K - β := by
      calc s * R ≤ (c * K - β) / R * R := Nat.mul_le_mul_right _ (min_le_right _ _)
        _ ≤ c * K - β := Nat.div_mul_le_self _ _
    have hs1 : s₁ ≤ s := by
      refine le_min h12 ?_
      rw [Nat.le_div_iff_mul_le hRp]
      omega
    refine ⟨s, hs1, min_le_left _ _, by omega, ?_⟩
    by_cases hlt : s < s₂
    · have hs' : s = (c * K - β) / R := by
        rcases min_cases s₂ ((c * K - β) / R) with ⟨h1, _⟩ | ⟨h1, _⟩
        · rw [← hs] at h1; omega
        · rw [← hs] at h1; exact h1
      have := Nat.lt_mul_div_succ (c * K - β) hRp
      rw [← hs'] at this
      have e : R * (s + 1) = s * R + R := by ring
      have : R ≤ s := le_trans hR hs1
      omega
    · have hss : s = s₂ := le_antisymm (min_le_left _ _) (by omega)
      rw [hss]; exact hc2

/-- A witness in `Z(N, s - 1)`: `x = zF N (s-1) a`, `N + 1 - y = zF N (s-1) (s - c)`. -/
theorem settled7_of_IZ {N x y a c s : Nat} (hx : 1 ≤ x) (ha : 2 ≤ a) (hxy : x + y ≤ N)
    (hs : 2 ≤ s) (hs2 : 2 * s ≤ N + 2) (hI1 : s * x ≤ a * (N + 2))
    (hI2 : a * (N + 2) + 1 ≤ s * (x + 1)) (hc1 : s * y + 1 ≤ c * (N + 2))
    (hc2 : c * (N + 2) ≤ s * y + s) : Settled7 N x (N + 1 - y) := by
  have hc0 : 1 ≤ c := by
    rcases Nat.eq_zero_or_pos c with h | h
    · rw [h, Nat.zero_mul] at hc1; omega
    · exact h
  have hac : a + c < s := by
    by_contra hcon
    push Not at hcon
    have h1 : s * (N + 2) ≤ (a + c) * (N + 2) := Nat.mul_le_mul_right _ hcon
    have h2 : s * (x + y + 2) ≤ s * (N + 2) := Nat.mul_le_mul_left _ (by omega)
    have e1 : (a + c) * (N + 2) = a * (N + 2) + c * (N + 2) := by ring
    have e2 : s * (x + y + 2) = s * (x + 1) + s * y + s := by ring
    omega
  have hp : s - 1 + 1 = s := by omega
  refine settled7_z (p := s - 1) (a := a) (b := s - c) (by omega) (by omega) (by omega)
    (by omega) (by omega) (deadB_false_of_lt ha) ?_ ?_
  · unfold zF beatty
    rw [Nat.sub_zero, hp]
    apply Nat.div_eq_of_lt_le
    · rw [Nat.mul_comm]; exact hI1
    · have : (x + 1) * s = s * (x + 1) := Nat.mul_comm _ _
      omega
  · unfold zF beatty
    rw [Nat.sub_zero, hp]
    have e : (s - c) * (N + 2) + c * (N + 2) = s * (N + 2) := by
      rw [← Nat.add_mul, Nat.sub_add_cancel (by omega)]
    have e2 : s * (N + 2) = s * (N + 1 - y) + s * y + s := by
      rw [← Nat.mul_add, ← Nat.mul_add_one]; congr 1; omega
    apply Nat.div_eq_of_lt_le
    · rw [Nat.mul_comm (N + 1 - y)]; omega
    · have e3 : (N + 1 - y + 1) * s = s * (N + 1 - y) + s := by ring
      omega

/-- A witness in `X(N, s, h)`: `x = beatty N s h a`, `N + 1 - y = beatty N s h (s - c)`. -/
theorem settled7_of_IX {N x y a c s h : Nat} (h1 : h ≤ 1) (hx : 1 ≤ x) (ha : 1 ≤ a)
    (hnd : 2 ≤ a ∨ h = 0)
    (hy : 2 ≤ y) (hxy : x + y ≤ N) (hs : 1 ≤ s) (hs2 : h + 2 * s ≤ N + 1)
    (hI1 : s * x + h ≤ a * N) (hI2 : a * N + 1 ≤ s * (x + 1) + h)
    (hc1 : s * (y - 2) + (1 - h) ≤ c * N) (hc2 : c * N + 1 ≤ s * (y - 2) + (1 - h) + s) :
    Settled7 N x (N + 1 - y) := by
  have hac : a + c < s := by
    by_contra hcon
    push Not at hcon
    have h3 : s * N ≤ (a + c) * N := Nat.mul_le_mul_right _ hcon
    have h4 : s * (x + y) ≤ s * N := Nat.mul_le_mul_left _ hxy
    have e1 : (a + c) * N = a * N + c * N := by ring
    have e2 : s * (x + y) = s * (x + 1) + s * (y - 2) + s := by
      have : x + y = (x + 1) + (y - 2) + 1 := by omega
      rw [this]; ring
    omega
  have hdead : deadB s a (s - c) = false := by
    rcases hnd with hnd | hnd
    · exact deadB_false_of_lt hnd
    · subst hnd
      have hc0 : 1 ≤ c := by
        rcases Nat.eq_zero_or_pos c with h0 | h0
        · rw [h0, Nat.zero_mul] at hc1; omega
        · exact h0
      exact deadB_false_of_ne (by omega)
  refine settled7_beatty (p := s) (h := h) (a := a) (b := s - c) hs hs2 h1 (by omega) (by omega)
    (by omega) hdead ?_ ?_
  · unfold beatty
    apply Nat.div_eq_of_lt_le
    · rw [Nat.mul_comm]; omega
    · have : (x + 1) * s = s * (x + 1) := Nat.mul_comm _ _
      omega
  · unfold beatty
    have e : (s - c) * N + c * N = s * N := by
      rw [← Nat.add_mul, Nat.sub_add_cancel (by omega)]
    have e2 : s * N = s * (N + 1 - y) + s * (y - 2) + s := by
      rw [← Nat.mul_add, ← Nat.mul_add_one]; congr 1; omega
    apply Nat.div_eq_of_lt_le
    · rw [Nat.mul_comm (N + 1 - y)]; omega
    · have e3 : (N + 1 - y + 1) * s = s * (N + 1 - y) + s := by ring
      omega

/-- The exact direct test: `S₂ = min ⌊(aK - α)/L⌋ smax`, `S₁ = max ⌈(aK - α + 1)/(L + 1)⌉ R 2`,
and the union `[S₁R + β, S₂R + β + S₂ - 1]` contains a multiple of `K`. -/
def dirOK (K L R α β smax a : Nat) : Bool :=
  let S2 := min ((a * K - α) / L) smax
  let S1 := max (max ((a * K - α + 1 + L) / (L + 1)) R) 2
  decide (S1 ≤ S2) && decide (S1 * R + β ≤ (S2 * R + β + S2 - 1) / K * K)

theorem dirOK_spec {K L R α β smax a : Nat} (hK : 0 < K) (hL : 1 ≤ L)
    (h : dirOK K L R α β smax a = true) :
    ∃ s c, 2 ≤ s ∧ s ≤ smax ∧ R ≤ s ∧ s * L + α ≤ a * K ∧ a * K + 1 ≤ s * (L + 1) + α ∧
      s * R + β ≤ c * K ∧ c * K + 1 ≤ s * R + β + s := by
  unfold dirOK at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨h12, hc⟩ := h
  set S2 := min ((a * K - α) / L) smax with hS2
  set S1 := max (max ((a * K - α + 1 + L) / (L + 1)) R) 2 with hS1
  set c := (S2 * R + β + S2 - 1) / K with hcdef
  have hc2 : c * K + 1 ≤ S2 * R + β + S2 := by
    have := Nat.div_mul_le_self (S2 * R + β + S2 - 1) K
    rw [← hcdef] at this
    have : 2 ≤ S2 := le_trans (le_max_right _ _) h12
    omega
  obtain ⟨s, hs1, hs2, hw1, hw2⟩ :=
    slideC (K := K) (R := R) (β := β) (c := c) (le_trans (le_max_right _ _) (le_max_left _ _))
      h12 hc hc2
  refine ⟨s, c, le_trans (le_max_right _ _) hs1, le_trans hs2 (min_le_right _ _),
    le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hs1, ?_, ?_, hw1, hw2⟩
  · -- s ≤ ⌊(aK - α)/L⌋
    have h3 : s ≤ (a * K - α) / L := le_trans hs2 (min_le_left _ _)
    have h4 := (Nat.le_div_iff_mul_le hL).1 h3
    have h5 : s ≤ s * L := Nat.le_mul_of_pos_right s hL
    have h6 : 2 ≤ s := le_trans (le_max_right _ _) hs1
    omega
  · -- s ≥ ⌈(aK - α + 1)/(L + 1)⌉
    have h3 : (a * K - α + 1 + L) / (L + 1) ≤ s := le_trans (le_trans (le_max_left _ _)
      (le_max_left _ _)) hs1
    have h4 := Nat.lt_mul_div_succ (a * K - α + 1 + L) (show 0 < L + 1 by omega)
    have h5 : (L + 1) * ((a * K - α + 1 + L) / (L + 1) + 1) ≤ (L + 1) * (s + 1) :=
      Nat.mul_le_mul_left _ (by omega)
    have e : (L + 1) * (s + 1) = s * (L + 1) + L + 1 := by ring
    omega

/-- The exact direct tests for the pair `(x, N + 1 - y)` with left index `a`:
`Z(N, ·)`, `X(N, ·, 0)`, `X(N, ·, 1)` (for `a = 1` only `X(N, ·, 0)`, whose right index is then
automatically `< p`, so that the preimage is not dead). -/
def dirAll (N x y a : Nat) : Bool :=
  if a = 1 then decide (2 ≤ y) && dirOK N x (y - 2) 0 1 ((N + 1) / 2) a
  else dirOK (N + 2) x y 0 1 ((N + 2) / 2) a ||
    (decide (2 ≤ y) && dirOK N x (y - 2) 0 1 ((N + 1) / 2) a) ||
    (decide (2 ≤ y) && dirOK N x (y - 2) 1 0 (N / 2) a)

theorem settled7_of_dirAll {N x y a : Nat} (hx : 1 ≤ x) (ha : 1 ≤ a) (hxy : x + y ≤ N)
    (h : dirAll N x y a = true) : Settled7 N x (N + 1 - y) := by
  unfold dirAll at h
  split_ifs at h with ha1
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨hy, h⟩ := h
    obtain ⟨s, c, hs, hs2, _, h1, h2, h3, h4⟩ := dirOK_spec (by omega) hx h
    exact settled7_of_IX (s := s) (c := c) (h := 0) (by omega) hx ha (Or.inr rfl) hy hxy
      (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
  have ha2 : 2 ≤ a := by omega
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
  rcases h with (h | ⟨hy, h⟩) | ⟨hy, h⟩
  · obtain ⟨s, c, hs, hs2, _, h1, h2, h3, h4⟩ := dirOK_spec (by omega) hx h
    exact settled7_of_IZ (s := s) (c := c) hx ha2 hxy hs (by omega) (by omega) (by omega)
      (by omega) (by omega)
  · obtain ⟨s, c, hs, hs2, _, h1, h2, h3, h4⟩ := dirOK_spec (by omega) hx h
    exact settled7_of_IX (s := s) (c := c) (h := 0) (by omega) hx ha (Or.inl ha2) hy hxy
      (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
  · obtain ⟨s, c, hs, hs2, _, h1, h2, h3, h4⟩ := dirOK_spec (by omega) hx h
    exact settled7_of_IX (s := s) (c := c) (h := 1) le_rfl hx ha (Or.inl ha2) hy hxy
      (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)

/-- Some `a ∈ [1, x + 1]` passes an exact direct test. -/
def dirAny (N x y : Nat) : Bool := (List.range' 1 (x + 1)).any fun a => dirAll N x y a

theorem settled7_of_dirAny {N x y : Nat} (hx : 1 ≤ x) (hxy : x + y ≤ N)
    (h : dirAny N x y = true) : Settled7 N x (N + 1 - y) := by
  unfold dirAny at h
  rw [List.any_eq_true] at h
  obtain ⟨a, ha, h⟩ := h
  rw [List.mem_range'_1] at ha
  exact settled7_of_dirAll hx ha.1 hxy h


/-! ## The pairs `(1, v)` and the special pairs with `u ≤ 3`, for all `N ≥ 65` -/

theorem settled7_swap {N p h c a b u v : Nat} (H : SwapHyp N p h c) (ha : 1 ≤ a) (hab : a < b)
    (hb : b ≤ p) (hd : deadB p a b = false) (e1 : swapF N p h c a = u)
    (e2 : swapF N p h c b = v) : Settled7 N u v :=
  Or.inl (Or.inr (Or.inr (Or.inr (Or.inl ⟨p, h, c, a, b, H, ha, hab, hb, hd, e1, e2⟩))))

theorem settled7_chiY {N a b u v : Nat} (h4 : N % 4 = 0) (h8 : 8 ≤ N) (ha : 1 ≤ a) (hab : a < b)
    (hb : b ≤ N / 2) (hd : deadB (N / 2) a b = false) (e1 : chiY a = u) (e2 : chiY b = v) :
    Settled7 N u v :=
  Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨a, b, h4, h8, ha, hab, hb, hd, e1, e2⟩)))))

theorem beatty_last {N p : Nat} (hp : 1 ≤ p) : beatty N p 0 p = N := by
  unfold beatty; rw [Nat.sub_zero, Nat.mul_comm]; exact Nat.mul_div_cancel _ (by omega)

/-- The element `x` and the last element `N` of `X(N, p, 0)`. -/
theorem settled7_left_N {N x a p : Nat} (ha : 1 ≤ a) (hap : a < p) (hp : 2 * p ≤ N + 1)
    (hd : 2 ≤ a ∨ (p % 2 = 1 ∧ p ≠ 7)) (h1 : x * p ≤ a * N) (h2 : a * N < (x + 1) * p) :
    Settled7 N x N := by
  refine settled7_beatty (p := p) (h := 0) (a := a) (b := p) (by omega) (by omega) (by omega) ha
    hap le_rfl ?_ ?_ (beatty_last (by omega))
  · rcases hd with hd | ⟨hd1, hd2⟩
    · exact deadB_false_of_lt hd
    · exact deadB_false_odd hd1 hd2
  · unfold beatty; rw [Nat.sub_zero]
    exact Nat.div_eq_of_lt_le h1 h2

/-- `(x, N)`, `x ∈ {2, 3}`: index `1` in `X(N, p, 0)`, `p` odd in `(N/(x + 1), N/x]`. -/
theorem settled7_small_N {N x : Nat} (hN : 65 ≤ N) (hx : 2 ≤ x) (hx3 : x ≤ 3) :
    Settled7 N x N := by
  interval_cases x
  · obtain ⟨p, h1, h2, h3⟩ : ∃ p, 2 * p ≤ N ∧ N < 3 * p ∧ p % 2 = 1 :=
      if h : (N / 2) % 2 = 1 then ⟨N / 2, by omega, by omega, h⟩
      else ⟨N / 2 - 1, by omega, by omega, by omega⟩
    exact settled7_left_N (a := 1) (p := p) le_rfl (by omega) (by omega)
      (Or.inr ⟨h3, by omega⟩) (by omega) (by omega)
  · obtain ⟨p, h1, h2, h3⟩ : ∃ p, 3 * p ≤ N ∧ N < 4 * p ∧ p % 2 = 1 :=
      if h : (N / 3) % 2 = 1 then ⟨N / 3, by omega, by omega, h⟩
      else ⟨N / 3 - 1, by omega, by omega, by omega⟩
    exact settled7_left_N (a := 1) (p := p) le_rfl (by omega) (by omega)
      (Or.inr ⟨h3, by omega⟩) (by omega) (by omega)

/-- **Construction A** for `(u', N)`: `4 ≤ u'`, `3u' ≤ N`,
`a = max 2 ⌈u'(u'+1)/N⌉`, `p = ⌊aN/u'⌋`. -/
theorem settled7_left_N_A {N x : Nat} (hN : 65 ≤ N) (hx : 4 ≤ x) (hx3 : 3 * x ≤ N) :
    Settled7 N x N := by
  set c := (x * (x + 1) + N - 1) / N with hc
  set a := max 2 c with ha
  set p := a * N / x with hp
  have ha2 : 2 ≤ a := le_max_left _ _
  have hca : c ≤ a := le_max_right _ _
  have f1 : x * (x + 1) + N - 1 < N * (c + 1) := Nat.lt_mul_div_succ _ (by omega)
  have f2 : N * c ≤ N * a := Nat.mul_le_mul_left _ hca
  have hceil : x * (x + 1) ≤ a * N := by
    have e : N * (c + 1) = N * c + N := by ring
    have e2 : N * a = a * N := Nat.mul_comm _ _
    omega
  have hp1 : p * x ≤ a * N := Nat.div_mul_le_self _ _
  have hp2 : a * N < x * (p + 1) := Nat.lt_mul_div_succ _ (by omega)
  have hpx : x + 1 ≤ p := by
    rw [hp, Nat.le_div_iff_mul_le (by omega)]
    calc (x + 1) * x = x * (x + 1) := by ring
      _ ≤ a * N := hceil
  have hp3 : 2 * p ≤ N + 1 := by
    by_cases hc3 : c ≤ 2
    · have ha' : a = 2 := by rw [ha]; omega
      have h4 : p * 4 ≤ p * x := Nat.mul_le_mul_left p hx
      rw [ha'] at hp1
      omega
    · have ha' : a = c := by rw [ha]; omega
      have h5 : c * N ≤ x * (x + 1) + N - 1 := Nat.div_mul_le_self _ _
      have claim : 2 * (x * (x + 1)) + 2 * N ≤ N * x := by nlinarith
      have h6 : 2 * p * x ≤ N * x := by
        rw [ha'] at hp1
        have : 2 * p * x = 2 * (p * x) := by ring
        omega
      have := Nat.le_of_mul_le_mul_right h6 (show 0 < x by omega)
      omega
  have hax : a ≤ x := by
    by_cases hc3 : c ≤ 2
    · rw [ha]; omega
    · have ha' : a = c := by rw [ha]; omega
      have h5 : c * N ≤ x * (x + 1) + N - 1 := Nat.div_mul_le_self _ _
      have h6 : c * N < (x + 1) * N := by
        have : x * (x + 1) + N - 1 < (x + 1) * N := by nlinarith
        omega
      have := Nat.lt_of_mul_lt_mul_right h6
      omega
  refine settled7_left_N (a := a) (p := p) (by omega) (by omega) hp3 (Or.inl ha2)
    (by rw [Nat.mul_comm]; exact hp1) ?_
  have e : x * (p + 1) = x * p + x := by ring
  have e2 : (x + 1) * p = x * p + p := by ring
  omega

/-- **Construction B** for `(u', N)`: `3u' > N`, `g = N - 2u' ≥ 3`,
`j = max 1 ⌈g(g - 2)/N⌉`, `a = ⌈u'j/g⌉`, `p = 2a + j`. -/
theorem settled7_left_N_B {N x : Nat} (hN : 65 ≤ N) (hx3 : N < 3 * x) (hg : 2 * x + 3 ≤ N) :
    Settled7 N x N := by
  obtain ⟨g, hgN⟩ : ∃ g, N = 2 * x + g + 2 := ⟨N - 2 * x - 2, by omega⟩
  have hg1 : 1 ≤ g := by omega
  set c := ((g + 2) * g + N - 1) / N with hc
  set j := max 1 c with hj
  set a := (x * j + g + 1) / (g + 2) with ha
  have hj1 : 1 ≤ j := le_max_left _ _
  have hcj : c ≤ j := le_max_right _ _
  -- F3: (g + 2) g ≤ j N
  have F3 : (g + 2) * g ≤ j * N := by
    have f1 : (g + 2) * g + N - 1 < N * (c + 1) := Nat.lt_mul_div_succ _ (by omega)
    have f2 : N * c ≤ N * j := Nat.mul_le_mul_left _ hcj
    have e : N * (c + 1) = N * c + N := by ring
    have e2 : N * j = j * N := Nat.mul_comm _ _
    omega
  -- F4: j N ≤ (g + 2) g + N - 1, or j = 1
  have F4 : j * N ≤ (g + 2) * g + N - 1 ∨ j = 1 := by
    by_cases h : c ≤ 1
    · right; rw [hj]; omega
    · left
      have : j = c := by rw [hj]; omega
      rw [this]
      exact Nat.div_mul_le_self _ _
  -- F1, F2: ceiling facts for a
  have F1 : x * j ≤ a * (g + 2) := by
    have h1 := Nat.lt_mul_div_succ (x * j + g + 1) (show 0 < g + 2 by omega)
    have e : (g + 2) * (a + 1) = a * (g + 2) + (g + 2) := by ring
    rw [← ha] at h1
    omega
  have F2 : a * (g + 2) ≤ x * j + g + 1 := by
    have h1 := Nat.div_mul_le_self (x * j + g + 1) (g + 2)
    rw [← ha] at h1
    exact h1
  have hxg : g + 2 < x := by omega
  have haa : 2 ≤ a := by
    by_contra h; push Not at h
    have h1 : a * (g + 2) ≤ 1 * (g + 2) := Nat.mul_le_mul_right _ (by omega)
    have h2 : x * 1 ≤ x * j := Nat.mul_le_mul_left _ hj1
    omega
  set p := 2 * a + j with hp
  have hjN : j * N = j * (2 * x + g + 2) := by rw [hgN]
  have h1 : x * p ≤ a * N := by
    have e1 : x * (2 * a + j) = 2 * (a * x) + x * j := by ring
    have e2 : a * (2 * x + g + 2) = 2 * (a * x) + a * (g + 2) := by ring
    rw [hp, hgN, e1, e2]; omega
  have key : a * g < x * j + j := by
    have h3 : g * (a * (g + 2)) ≤ g * (x * j + g + 1) := Nat.mul_le_mul_left _ F2
    have e3 : (a * g) * (g + 2) = g * (a * (g + 2)) := by ring
    have e4 : g * (x * j + g + 1) + g = g * (x * j) + (g + 2) * g := by ring
    have e5 : (x * j + j) * (g + 2) = g * (x * j) + j * (2 * x + g + 2) := by ring
    have h4 : (a * g) * (g + 2) < (x * j + j) * (g + 2) := by omega
    exact Nat.lt_of_mul_lt_mul_right h4
  have h2 : a * N < (x + 1) * p := by
    have e1 : a * (2 * x + g + 2) = 2 * (a * x) + a * g + 2 * a := by ring
    have e2 : (x + 1) * (2 * a + j) = 2 * (a * x) + 2 * a + (x * j + j) := by ring
    rw [hp, hgN, e1, e2]; omega
  have hp2 : 2 * p ≤ N + 1 := by
    have h5 : p * (g + 2) ≤ j * N + 2 * g + 2 := by
      have e1 : (2 * a + j) * (g + 2) = 2 * (a * (g + 2)) + j * (g + 2) := by ring
      have e2 : j * (2 * x + g + 2) = 2 * (x * j) + j * (g + 2) := by ring
      rw [hp, e1, hjN, e2]; omega
    have hG : 3 * (g + 2) < N := by omega
    have h6 : 2 * p * (g + 2) ≤ (N + 1) * (g + 2) := by
      have hGN : 65 * (g + 2) ≤ N * (g + 2) := Nat.mul_le_mul_right _ hN
      have hprod : 3 * ((g + 2) * (g + 2)) + 3 * N ≤ (g + 2) * N + 9 * (g + 2) := by
        have : (g + 2 - 3) * (N - 3 * (g + 2)) + 3 * ((g + 2) * (g + 2)) + 3 * N =
            (g + 2) * N + 9 * (g + 2) := by
          zify [(by omega : 3 ≤ g + 2), (by omega : 3 * (g + 2) ≤ N)]
          ring
        omega
      have e1 : 2 * p * (g + 2) = 2 * (p * (g + 2)) := by ring
      have e2 : (N + 1) * (g + 2) = (g + 2) * N + (g + 2) := by ring
      have e3 : (g + 2) * g + 2 * g + 2 + 2 = (g + 2) * (g + 2) := by ring
      have e4 : N * (g + 2) = (g + 2) * N := Nat.mul_comm _ _
      rcases F4 with F4 | F4
      · omega
      · rw [F4, Nat.one_mul] at h5
        have h7 : 3 * N ≤ (g + 2) * N := Nat.mul_le_mul_right _ (by omega)
        omega
    exact Nat.le_of_mul_le_mul_right h6 (by omega)
  exact settled7_left_N (a := a) (p := p) (by omega) (by omega) hp2 (Or.inl haa) h1 h2

/-- **Every pair `(1, v)` with `v` even, `(N + 4)/2 ≤ v ≤ N - 1` is settled** (`N ≥ 65`): its
mirror `(u', N)` by `X(N, p, 0)` (`u' = N + 1 - v`), or `(1, N/2 + 2)` by `chiY`. -/
theorem settled7_one_v {N v : Nat} (hN : 65 ≤ N) (hv : v % 2 = 0) (hv1 : N + 4 ≤ 2 * v)
    (hv2 : v + 1 ≤ N) : Settled7 N 1 v ∨ Settled7 N (N + 1 - v) (N + 1 - 1) := by
  rw [show N + 1 - 1 = N by omega]
  set x := N + 1 - v with hx
  by_cases hg : 2 * x + 2 = N
  · -- chiY: v = N/2 + 2, N = 0 mod 4
    left
    have h4 : N % 4 = 0 := by omega
    refine settled7_chiY (a := 1) (b := N / 4 + 1) h4 (by omega) le_rfl (by omega) (by omega)
      (deadB_false_of_ne (by omega)) (by simp [chiY]) ?_
    simp only [chiY]
    split_ifs <;> omega
  right
  by_cases h2 : x ≤ 3
  · exact settled7_small_N hN (by omega) h2
  by_cases h3 : 3 * x ≤ N
  · exact settled7_left_N_A hN (by omega) h3
  · exact settled7_left_N_B hN (by omega) (by omega)

/-- `(3, N - 1)`, `N` odd: the corner `(1, p)` of `X(N, p, 1)`, `p` odd, `3p ≤ N - 1 < 4p`. -/
theorem settled7_three_N1 {N : Nat} (hN : 65 ≤ N) : Settled7 N 3 (N - 1) := by
  obtain ⟨p, hp1, hp2, hpo⟩ : ∃ p, 3 * p ≤ N - 1 ∧ N - 1 < 4 * p ∧ p % 2 = 1 :=
    if h : ((N - 1) / 3) % 2 = 1 then ⟨(N - 1) / 3, by omega, by omega, h⟩
    else ⟨(N - 1) / 3 - 1, by omega, by omega, by omega⟩
  refine settled7_beatty (p := p) (h := 1) (a := 1) (b := p) (by omega) (by omega) le_rfl le_rfl
    (by omega) le_rfl (deadB_false_odd hpo (by omega)) ?_ ?_
  · unfold beatty; rw [Nat.one_mul]
    exact Nat.div_eq_of_lt_le (by omega) (by omega)
  · unfold beatty
    apply Nat.div_eq_of_lt_le
    · obtain ⟨m, rfl⟩ : ∃ m, N = m + 1 := ⟨N - 1, by omega⟩
      have e : p * (m + 1) = m * p + p := by ring
      rw [show m + 1 - 1 = m by omega]
      omega
    · obtain ⟨m, rfl⟩ : ∃ m, N = m + 1 := ⟨N - 1, by omega⟩
      have e : p * (m + 1) = m * p + p := by ring
      rw [show m + 1 - 1 = m by omega]
      have e2 : (m + 1) * p = m * p + p := by ring
      omega

/-- `(3, N - 2)`, `N` even: the corner `(1, p)` of `Z(N, p)`, `3(p + 1) < N + 2 < 4(p + 1)`. -/
theorem settled7_three_N2 {N : Nat} (hN : 65 ≤ N) : Settled7 N 3 (N - 2) := by
  obtain ⟨p, hp1, hp2, hpo⟩ : ∃ p, 3 * (p + 1) < N + 2 ∧ N + 2 < 4 * (p + 1) ∧ p % 2 = 1 :=
    if h : ((N - 2) / 3) % 2 = 1 then ⟨(N - 2) / 3, by omega, by omega, h⟩
    else ⟨(N - 2) / 3 - 1, by omega, by omega, by omega⟩
  obtain ⟨e1, e2⟩ := zF_corner (N := N) (p := p) (c := 3) hp1 hp2
  refine settled7_z (p := p) (a := 1) (b := p) (by omega) (by omega) le_rfl (by omega) le_rfl
    (deadB_false_odd hpo (by omega)) e1 ?_
  rw [e2]; omega

/-- `(4, N - 2)`, `N` odd: the corner of a swapped copy (Live6 `coReach_three`). -/
theorem settled7_four_N2 {N : Nat} (hN : 65 ≤ N) : Settled7 N 4 (N - 2) := by
  obtain ⟨p, hp⟩ : ∃ p, p = if (N - 1) / 4 % 2 = 1 then (N - 1) / 4 else (N - 1) / 4 - 1 :=
    ⟨_, rfl⟩
  have hp9 : 15 ≤ p ∧ p % 2 = 1 ∧ 4 * p ≤ N - 1 ∧ N - 1 < 5 * p := by
    rw [hp]; split_ifs <;> omega
  have H : SwapHyp N p 1 2 := ⟨by omega, hp9.2.1, le_rfl, le_rfl, by omega⟩
  refine settled7_swap H (a := 1) (b := p) le_rfl (by omega) le_rfl
    (deadB_false_odd hp9.2.1 (by omega)) ?_ swapF_top
  rw [swapF_lt (by omega)]
  unfold beatty; rw [Nat.one_mul]
  exact Nat.div_eq_of_lt_le (by omega) (by omega)

/-- `(3, (N + 6)/2)`, `N ≡ 2 mod 4`: `X(N, p, 0)`, `p` even, `3p ≤ N < 4p`, indices `1`,
`p/2 + 1`. -/
theorem settled7_three_half {N : Nat} (hN : 65 ≤ N) (h4 : N % 4 = 2) :
    Settled7 N 3 ((N + 6) / 2) := by
  obtain ⟨r, hr1, hr2⟩ : ∃ r, 3 * (2 * r) ≤ N ∧ N < 4 * (2 * r) :=
    if h : (N / 3) % 2 = 0 then ⟨N / 6, by omega, by omega⟩
    else ⟨N / 6, by omega, by omega⟩
  refine settled7_beatty (p := 2 * r) (h := 0) (a := 1) (b := r + 1) (by omega) (by omega)
    (by omega) le_rfl (by omega) (by omega) (deadB_false_of_ne (by omega)) ?_ ?_
  · unfold beatty; rw [Nat.sub_zero, Nat.one_mul]
    exact Nat.div_eq_of_lt_le (by omega) (by omega)
  · unfold beatty; rw [Nat.sub_zero]
    obtain ⟨n, rfl⟩ : ∃ n, N = 2 * n := ⟨N / 2, by omega⟩
    apply Nat.div_eq_of_lt_le
    · have e : (r + 1) * (2 * n) = 2 * r * n + 2 * n := by ring
      have e2 : (2 * n + 6) / 2 = n + 3 := by omega
      rw [e2]
      have e3 : (n + 3) * (2 * r) = 2 * r * n + 6 * r := by ring
      omega
    · have e : (r + 1) * (2 * n) = 2 * r * n + 2 * n := by ring
      have e2 : (2 * n + 6) / 2 = n + 3 := by omega
      rw [e2]
      have e3 : (n + 3 + 1) * (2 * r) = 2 * r * n + 8 * r := by ring
      omega

/-! ## The arithmetic covering statement -/

/-- The special pairs `(u, u')` (`u' = N + 1 - v`) settled by the lemmas above. -/
def Special (N u u' : Nat) : Prop :=
  (u = 2 ∧ (u' = 2 ∨ u' = 3)) ∨ (u = 3 ∧ (u' = 3 ∨ u' = 4)) ∨ (u = 3 ∧ N % 4 = 2 ∧ 2 * u' + 4 = N)

/-- **The arithmetic covering statement**: every mixed-parity wide pair `(u, v)`,
`u + v ≤ N + 1`, `u ≥ 2`, other than the special pairs, passes an exact direct test (`dirAny`)
in one of its two orientations (`u' = N + 1 - v`).  Purely arithmetic (floors and one
multiple of `K` in an interval); verified for `65 ≤ N ≤ 3000` (`dircheck2.c`). -/
def ArithCover (N : Nat) : Prop :=
  ∀ u v, 2 ≤ u → u < v → u + v ≤ N + 1 → (u + v) % 2 = 1 → 2 * u + 2 ≤ v →
    N + u + 3 ≤ 2 * v → ¬ Special N u (N + 1 - v) →
      dirAny N u (N + 1 - v) = true ∨ dirAny N (N + 1 - v) u = true

theorem mixedCover_of_arith {N : Nat} (hN : 65 ≤ N) (hA : ArithCover N) : MixedCover N := by
  intro u v hu huv hs hp h1 h2 hd
  by_cases hu1 : u = 1
  · subst hu1
    have hvN : v + 1 ≤ N := by
      by_contra h
      have : v = N := by omega
      subst this
      unfold deadB at hd
      simp at hd
      omega
    exact settled7_one_v hN (by omega) (by omega) hvN
  by_cases hS : Special N u (N + 1 - v)
  · rcases hS with ⟨rfl, h | h⟩ | ⟨rfl, h | h⟩ | ⟨rfl, h4, h⟩
    · -- (2, N - 1), N even: settled_evenEven
      left
      exact settled_evenEven (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
        (by omega) (by omega)
    · -- (2, N - 2), N odd: mirror (3, N - 1)
      right
      rw [show N + 1 - v = 3 by omega, show N + 1 - 2 = N - 1 by omega]
      exact settled7_three_N1 hN
    · -- (3, N - 2), N even
      left
      rw [show v = N - 2 by omega]
      exact settled7_three_N2 hN
    · -- (3, N - 3), N odd: mirror (4, N - 2)
      right
      rw [show N + 1 - v = 4 by omega, show N + 1 - 3 = N - 2 by omega]
      exact settled7_four_N2 hN
    · -- (3, (N + 6)/2), N ≡ 2 mod 4
      left
      rw [show v = (N + 6) / 2 by omega]
      exact settled7_three_half hN h4
  rcases hA u v (by omega) huv hs hp h1 h2 hS with h | h
  · left
    have := settled7_of_dirAny (N := N) (x := u) (y := N + 1 - v) hu (by omega) h
    rwa [show N + 1 - (N + 1 - v) = v by omega] at this
  · right
    exact settled7_of_dirAny (N := N) (x := N + 1 - v) (y := u) (by omega) (by omega) h

/-! ## The covering statement for `65 ≤ N ≤ 300`, by verified certificates

Every mixed-parity wide pair `(u, v)`, `u + v ≤ N + 1`, gets a certificate (orientation, family
`X(N, p, 0)`, `X(N, p, 1)` or `Z(N, p)`, and `p`; a full `settled7B` search for the few pairs
of the families `(1, N/2 + 2)`, `(3, N - 3)`), checked by `mixedB` (one `decide` per `N`,
about 2.2 GB and 10 s at `N = 300`). -/

