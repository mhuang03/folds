/-! ## Four labels -/

theorem admBound_four : AdmBound 4 := by
  refine admBound_succ admBound_three (fun hadm ht => ?_)
  exact bound_of_noLab 4 61 noLab_L61_4
    (noLab_cons noLab_F31_4 <| noLab_cons noLab_F32_4 <| noLab_cons noLab_F33_4 <|
      noLab_cons noLab_F34_4 <| noLab_cons noLab_F35_4 <| noLab_cons noLab_F36_4 <|
      noLab_cons noLab_F37_4 <| noLab_cons noLab_F38_4 <| noLab_cons noLab_F39_4 <|
      noLab_cons noLab_F40_4 <| noLab_cons noLab_F41_4 <| noLab_cons noLab_F42_4 <|
      noLab_cons noLab_F43_4 <| noLab_cons noLab_F44_4 <| noLab_cons noLab_F45_4 <|
      noLab_cons noLab_F46_4 <| noLab_cons noLab_F47_4 <| noLab_cons noLab_F48_4 <|
      noLab_cons noLab_F49_4 <| noLab_cons noLab_F50_4 <| noLab_cons noLab_F51_4 <|
      noLab_cons noLab_F52_4 <| noLab_cons noLab_F53_4 <| noLab_cons noLab_F54_4 <|
      noLab_cons noLab_F55_4 <| noLab_cons noLab_F56_4 <| noLab_cons noLab_F57_4 <|
      noLab_cons noLab_F58_4 <| noLab_cons noLab_F59_4 <| noLab_cons noLab_F60_4 noLab_nil)
    hadm ht

end LSAT

/-- **The conjecture for at most four labels**, for every `N`. -/
theorem admissible_le_four {N t : Nat} {c : Nat → Nat} (htt : t ≤ 4) (hadm : Admissible N c)
    (ht : ∀ x, 1 ≤ x → x ≤ N → c x < t) : N ≤ 2 ^ (t + 1) - 2 :=
  LSAT.admBound_four htt hadm ht

/-- **Level labellings, at most four levels.**  If `c` increases strictly along inversions of a
semi-symmetric fold sequence and takes values `< t`, then `min(⌊log₂(N+1)⌋, 5) ≤ t`. -/
theorem lds_exact_le_four {N : Nat} {a : List Nat} (hf : IsFoldSeq N a) (h : SemiSymmetric N a)
    (c : Nat → Nat) {t : Nat}
    (hc : ∀ i j (hij : i < j) (hj : j < a.length),
      a[j] < a[i]'(Nat.lt_trans hij hj) → c a[i] < c a[j])
    (ht : ∀ x ∈ a, c x < t) : min (Nat.log 2 (N + 1)) 5 ≤ t :=
  LSAT.lds_of_bound LSAT.admBound_four hf h c hc ht

/-- **Descents.**  A semi-symmetric fold sequence has `des a + 1 ≥ min(⌊log₂(N+1)⌋, 5)`:
`des a ≥ ⌊log₂(N+1)⌋ - 1` for `N ≤ 62`, and `des a ≥ 4` for every `N ≥ 31`. -/
theorem descents_exact_le_four {N : Nat} {a : List Nat} (hf : IsFoldSeq N a)
    (h : SemiSymmetric N a) : min (Nat.log 2 (N + 1)) 5 ≤ des a + 1 :=
  LSAT.descents_of_bound LSAT.admBound_four hf h

end Folds
