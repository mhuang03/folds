import Folds.SelfDual

/-!
# A congruence modulo 8 from a third involution

`Folds.Congruence` proves `a(N) ≡ c(N) (mod 4)` from the Klein four-group generated by
reversal `R` and mirror `M`.  Here we add a third involution for even `N = 2n`: the swap `T`
of the two middle entries (positions `n - 1`, `n`), applied when the swapped sequence is
again semi-symmetric (this happens exactly when the two middle panels lie outside each
other's windows).  `T` commutes with `R` and `M`, so `⟨R, M, T⟩ ≅ (ℤ/2)³` acts on the set
`midSwappable N` of semi-symmetric sequences whose middle swap is semi-symmetric.

* `card_mod_eight_free`: if three commuting involutions act on a finite set and all seven
  non-trivial elements of the group they generate are fixed-point free, the set has size
  `≡ 0 (mod 8)`.  (Proof: pass to the pairs `{x, T x}` and apply `card_mod_four`.)
* `card_mod_eight`: the same when `R ∘ M` may have fixed points:
  `|X| ≡ |Fix (R ∘ M)| (mod 8)`.
* `midSwappable_mod_eight`: for `N = 2n`, `n ≥ 2`,
  `#{a semi-symmetric : the middle swap of a is semi-symmetric}
     ≡ #{such a that are self-dual} (mod 8)`.
* `midSwappable_selfDual_mod_four`: the right side is `≡ 0 (mod 4)`.
* `semiCount_mod_eight_mid`: equivalently
  `a(2n) + d(2n) ≡ c(2n) + #{a semi-symmetric : middle swap not semi-symmetric} (mod 8)`,
  where `d(2n)` counts self-dual sequences whose middle swap is not semi-symmetric.

For self-dual sequences the middle swap is the flip of the last half step
(`Folds.SelfDual`, `flipLast`), so the right side of `midSwappable_mod_eight` is the number of
self-dual sequences whose last half step is an outer pair (`experiments/mod8/NOTES.txt`).
-/

namespace Folds

open Finset

section Abstract

variable {α : Type*} [DecidableEq α]

/-- **Free `(ℤ/2)³`-actions.**  If `R`, `M`, `T` are commuting involutions of a finite set `X`
and none of `R, M, RM, T, TR, TM, TRM` has a fixed point, then `8 ∣ |X|`. -/
theorem card_mod_eight_free (R M T : α → α) (X : Finset α)
    (hR : ∀ x ∈ X, R x ∈ X) (hM : ∀ x ∈ X, M x ∈ X) (hT : ∀ x ∈ X, T x ∈ X)
    (hRR : ∀ x ∈ X, R (R x) = x) (hMM : ∀ x ∈ X, M (M x) = x) (hTT : ∀ x ∈ X, T (T x) = x)
    (hRM : ∀ x ∈ X, R (M x) = M (R x)) (hRT : ∀ x ∈ X, R (T x) = T (R x))
    (hMT : ∀ x ∈ X, M (T x) = T (M x))
    (fR : ∀ x ∈ X, R x ≠ x) (fM : ∀ x ∈ X, M x ≠ x) (fRM : ∀ x ∈ X, R (M x) ≠ x)
    (fT : ∀ x ∈ X, T x ≠ x) (fTR : ∀ x ∈ X, T (R x) ≠ x) (fTM : ∀ x ∈ X, T (M x) ≠ x)
    (fTRM : ∀ x ∈ X, T (R (M x)) ≠ x) :
    X.card % 8 = 0 := by
  let f : α → Finset α := fun x => {x, T x}
  let Q := X.image f
  -- the fibres of `f` are the pairs `{x, T x}`
  have hfib : ∀ q ∈ Q, (X.filter (fun x => f x = q)).card = 2 := by
    intro q hq
    obtain ⟨x0, hx0, rfl⟩ := Finset.mem_image.1 hq
    have : X.filter (fun x => f x = f x0) = {x0, T x0} := by
      ext y
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton, f]
      constructor
      · rintro ⟨-, h⟩
        have : y ∈ ({y, T y} : Finset α) := by simp
        rw [h] at this
        simpa using this
      · rintro (rfl | rfl)
        · exact ⟨hx0, rfl⟩
        · refine ⟨hT _ hx0, ?_⟩
          rw [hTT _ hx0, Finset.pair_comm]
    rw [this]
    exact Finset.card_pair_eq_two_iff.2 (fT x0 hx0).symm
  have hX : X.card = 2 * Q.card := by
    rw [Finset.card_eq_sum_card_image f X, Finset.sum_const_nat hfib, mul_comm]
  -- the induced maps on pairs
  have imgR : ∀ x ∈ X, (f x).image R = f (R x) := by
    intro x hx; simp only [f, Finset.image_insert, Finset.image_singleton, hRT x hx]
  have imgM : ∀ x ∈ X, (f x).image M = f (M x) := by
    intro x hx; simp only [f, Finset.image_insert, Finset.image_singleton, hMT x hx]
  have pair_eq : ∀ x y, f y = f x → y = x ∨ y = T x := by
    intro x y h
    have : y ∈ f y := by simp [f]
    rw [h] at this
    simpa [f] using this
  have hQ : ∀ q ∈ Q, ∃ x ∈ X, q = f x := by
    intro q hq; obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 hq; exact ⟨x, hx, rfl⟩
  have h4 := card_mod_four (Finset.image R) (Finset.image M) _ Q rfl
    (fun q hq => by
      obtain ⟨x, hx, rfl⟩ := hQ q hq
      rw [imgR x hx]; exact Finset.mem_image_of_mem f (hR x hx))
    (fun q hq => by
      obtain ⟨x, hx, rfl⟩ := hQ q hq
      rw [imgM x hx]; exact Finset.mem_image_of_mem f (hM x hx))
    (fun q hq => by
      obtain ⟨x, hx, rfl⟩ := hQ q hq
      rw [imgR x hx, imgR _ (hR x hx), hRR x hx])
    (fun q hq => by
      obtain ⟨x, hx, rfl⟩ := hQ q hq
      rw [imgM x hx, imgM _ (hM x hx), hMM x hx])
    (fun q hq => by
      obtain ⟨x, hx, rfl⟩ := hQ q hq
      rw [imgM x hx, imgR _ (hM x hx), imgR x hx, imgM _ (hR x hx), hRM x hx])
    (fun q hq => by
      obtain ⟨x, hx, rfl⟩ := hQ q hq
      rw [imgR x hx]
      intro h
      rcases pair_eq x (R x) h with h1 | h1
      · exact fR x hx h1
      · exact fTR x hx (by rw [h1, hTT x hx]))
    (fun q hq => by
      obtain ⟨x, hx, rfl⟩ := hQ q hq
      rw [imgM x hx]
      intro h
      rcases pair_eq x (M x) h with h1 | h1
      · exact fM x hx h1
      · exact fTM x hx (by rw [h1, hTT x hx]))
  have h0 : (Q.filter fun q => (q.image M).image R = q) = ∅ := by
    apply Finset.filter_false_of_mem
    intro q hq
    obtain ⟨x, hx, rfl⟩ := hQ q hq
    rw [imgM x hx, imgR _ (hM x hx)]
    intro h
    rcases pair_eq x (R (M x)) h with h1 | h1
    · exact fRM x hx h1
    · exact fTRM x hx (by rw [h1, hTT x hx])
  rw [h0, Finset.card_empty] at h4
  omega

/-- **Orbit counting for `(ℤ/2)³` modulo 8.**  Let `R`, `M`, `T` be commuting involutions of a
finite set `X` such that every non-trivial element of `⟨R, M, T⟩` other than `R ∘ M` is fixed
point free.  Then `|X| ≡ |Fix (R ∘ M)| (mod 8)`. -/
theorem card_mod_eight (R M T : α → α) (X : Finset α)
    (hR : ∀ x ∈ X, R x ∈ X) (hM : ∀ x ∈ X, M x ∈ X) (hT : ∀ x ∈ X, T x ∈ X)
    (hRR : ∀ x ∈ X, R (R x) = x) (hMM : ∀ x ∈ X, M (M x) = x) (hTT : ∀ x ∈ X, T (T x) = x)
    (hRM : ∀ x ∈ X, R (M x) = M (R x)) (hRT : ∀ x ∈ X, R (T x) = T (R x))
    (hMT : ∀ x ∈ X, M (T x) = T (M x))
    (fR : ∀ x ∈ X, R x ≠ x) (fM : ∀ x ∈ X, M x ≠ x)
    (fT : ∀ x ∈ X, T x ≠ x) (fTR : ∀ x ∈ X, T (R x) ≠ x) (fTM : ∀ x ∈ X, T (M x) ≠ x)
    (fTRM : ∀ x ∈ X, T (R (M x)) ≠ x) :
    X.card % 8 = (X.filter fun x => R (M x) = x).card % 8 := by
  have hsplit := Finset.card_filter_add_card_filter_not (s := X) (fun x => R (M x) = x)
  set Y := X.filter fun x => ¬ R (M x) = x with hYdef
  have hY : ∀ x ∈ Y, x ∈ X ∧ R (M x) ≠ x := fun x hx => by
    rw [hYdef, Finset.mem_filter] at hx; exact hx
  have hRMR : ∀ x ∈ X, R (M (R x)) = M x := by
    intro x hx; rw [← hRM x hx, hRR _ (hM x hx)]
  have hMR : ∀ x ∈ X, R (M x) ≠ x → M x ≠ R x := by
    intro x hx h e; apply h; rw [e, hRR x hx]
  have hYR : ∀ x ∈ Y, R x ∈ Y := by
    intro x hx; obtain ⟨hx, h⟩ := hY x hx
    refine Finset.mem_filter.2 ⟨hR x hx, ?_⟩
    rw [hRMR x hx]; exact hMR x hx h
  have hYM : ∀ x ∈ Y, M x ∈ Y := by
    intro x hx; obtain ⟨hx, h⟩ := hY x hx
    refine Finset.mem_filter.2 ⟨hM x hx, ?_⟩
    rw [hMM x hx]; exact fun e => hMR x hx h e.symm
  have hYT : ∀ x ∈ Y, T x ∈ Y := by
    intro x hx; obtain ⟨hx, h⟩ := hY x hx
    refine Finset.mem_filter.2 ⟨hT x hx, ?_⟩
    rw [hMT x hx, hRT _ (hM x hx)]
    intro e; apply h
    have := congrArg T e
    rwa [hTT _ (hR _ (hM x hx)), hTT x hx] at this
  have h8 := card_mod_eight_free R M T Y hYR hYM hYT
    (fun x hx => hRR x (hY x hx).1) (fun x hx => hMM x (hY x hx).1)
    (fun x hx => hTT x (hY x hx).1) (fun x hx => hRM x (hY x hx).1)
    (fun x hx => hRT x (hY x hx).1) (fun x hx => hMT x (hY x hx).1)
    (fun x hx => fR x (hY x hx).1) (fun x hx => fM x (hY x hx).1) (fun x hx => (hY x hx).2)
    (fun x hx => fT x (hY x hx).1) (fun x hx => fTR x (hY x hx).1)
    (fun x hx => fTM x (hY x hx).1) (fun x hx => fTRM x (hY x hx).1)
  omega

end Abstract

/-! ## The middle swap -/

/-- Exchange the entries at positions `n - 1` and `n` (0-based). -/
def swapMid (n : ℕ) (a : List ℕ) : List ℕ :=
  (a.set (n - 1) (a.getD n 0)).set n (a.getD (n - 1) 0)

theorem length_swapMid (n : ℕ) (a : List ℕ) : (swapMid n a).length = a.length := by
  simp [swapMid]

theorem getElem_swapMid {n : ℕ} {a : List ℕ} (hn : 1 ≤ n) (ha : n < a.length) {k : ℕ}
    (hk : k < (swapMid n a).length) :
    (swapMid n a)[k] = if k = n - 1 then a[n] else if k = n then a[n - 1]
      else a[k]'(by rw [length_swapMid] at hk; exact hk) := by
  simp only [swapMid, List.getElem_set, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem ha,
    List.getElem?_eq_getElem (show n - 1 < a.length by omega), Option.getD_some]
  split_ifs <;> omega

theorem swapMid_swapMid {n : ℕ} {a : List ℕ} (hn : 1 ≤ n) (ha : n < a.length) :
    swapMid n (swapMid n a) = a := by
  have h1 : n < (swapMid n a).length := by rw [length_swapMid]; exact ha
  apply List.ext_getElem (by simp [length_swapMid])
  intro k hk _
  simp only [getElem_swapMid hn h1, getElem_swapMid hn ha]
  split_ifs <;> first | omega | (subst_vars; rfl)

theorem reverse_swapMid {n : ℕ} {a : List ℕ} (hn : 1 ≤ n) (ha : a.length = 2 * n) :
    (swapMid n a).reverse = swapMid n a.reverse := by
  have h1 : n < a.length := by omega
  have h2 : n < a.reverse.length := by simp; omega
  apply List.ext_getElem (by simp [length_swapMid])
  intro k hk _
  have l1 : (swapMid n a).reverse.length = 2 * n := by simp [length_swapMid, ha]
  have l2 : (swapMid n a.reverse).length = 2 * n := by simp [length_swapMid, ha]
  rw [List.getElem_reverse, getElem_swapMid hn h1, getElem_swapMid hn h2]
  simp only [List.getElem_reverse, length_swapMid]
  split_ifs <;> first | omega | (congr 1; omega)

theorem mirror_swapMid {N n : ℕ} {a : List ℕ} (hn : 1 ≤ n) (ha : n < a.length) :
    mirror N (swapMid n a) = swapMid n (mirror N a) := by
  unfold mirror
  have h2 : n < (a.map (N + 1 - ·)).length := by simp; omega
  apply List.ext_getElem (by simp [length_swapMid])
  intro k hk _
  simp only [List.getElem_map, getElem_swapMid hn ha, getElem_swapMid hn h2]
  split_ifs <;> rfl

/-- The middle swap of `a` is again semi-symmetric. -/
def midSwappable (N : ℕ) : Finset (List ℕ) :=
  (semiSeqs N).filter fun a => swapMid (N / 2) a ∈ semiSeqs N

section Facts

variable {n : ℕ} {a : List ℕ}

theorem length_of_mem_semiSeqs (ha : a ∈ semiSeqs (2 * n)) : a.length = 2 * n := by
  rw [(mem_semiSeqs.1 ha).1.length_eq]; simp

theorem bound_of_mem_semiSeqs (ha : a ∈ semiSeqs (2 * n)) (k : ℕ) (hk : k < a.length) :
    1 ≤ a[k] ∧ a[k] ≤ 2 * n :=
  (mem_range'_of_perm (mem_semiSeqs.1 ha).1).1 (List.getElem_mem hk)

/-- `T` has no fixed point (the two middle entries differ). -/
theorem swapMid_ne_self (hn : 2 ≤ n) (ha : a ∈ semiSeqs (2 * n)) : swapMid n a ≠ a := by
  have hl := length_of_mem_semiSeqs ha
  intro e
  have e1 : (swapMid n a)[n - 1]'(by rw [length_swapMid]; omega) = a[n - 1]'(by omega) := by
    simp only [e]
  rw [getElem_swapMid (by omega) (by omega)] at e1
  simp only [↓reduceIte] at e1
  have := (List.Nodup.getElem_inj (nodup_of_foldSeq (mem_semiSeqs.1 ha).1)).1 e1
  omega

/-- `T ∘ R` has no fixed point (look at the first entry). -/
theorem swapMid_reverse_ne (hn : 2 ≤ n) (ha : a ∈ semiSeqs (2 * n)) :
    swapMid n a.reverse ≠ a := by
  have hl := length_of_mem_semiSeqs ha
  intro e
  have e1 : (swapMid n a.reverse)[0]'(by rw [length_swapMid]; simp; omega) =
      a[0]'(by omega) := by simp only [e]
  rw [getElem_swapMid (by omega) (by simp; omega)] at e1
  split_ifs at e1 with c1 c2
  · omega
  · omega
  rw [List.getElem_reverse] at e1
  have := (List.Nodup.getElem_inj (nodup_of_foldSeq (mem_semiSeqs.1 ha).1)).1 e1
  omega

/-- `T ∘ M` has no fixed point (the first entry would be `(2n+1)/2`). -/
theorem swapMid_mirror_ne (hn : 2 ≤ n) (ha : a ∈ semiSeqs (2 * n)) :
    swapMid n (mirror (2 * n) a) ≠ a := by
  have hl := length_of_mem_semiSeqs ha
  intro e
  have e1 : (swapMid n (mirror (2 * n) a))[0]'(by rw [length_swapMid]; simp [mirror]; omega) =
      a[0]'(by omega) := by simp only [e]
  rw [getElem_swapMid (by omega) (by simp [mirror]; omega)] at e1
  split_ifs at e1 with c1 c2
  · omega
  · omega
  simp only [mirror, List.getElem_map] at e1
  have := bound_of_mem_semiSeqs ha 0 (by omega)
  omega

/-- `T ∘ R ∘ M` has no fixed point (entry `n - 1` would be `(2n+1)/2`). -/
theorem swapMid_revMirror_ne (hn : 2 ≤ n) (ha : a ∈ semiSeqs (2 * n)) :
    swapMid n (mirror (2 * n) a).reverse ≠ a := by
  have hl := length_of_mem_semiSeqs ha
  intro e
  have e1 : (swapMid n (mirror (2 * n) a).reverse)[n - 1]'(by
      rw [length_swapMid]; simp [mirror]; omega) = a[n - 1]'(by omega) := by simp only [e]
  rw [getElem_swapMid (by omega) (by simp [mirror]; omega)] at e1
  simp only [↓reduceIte, List.getElem_reverse, mirror, List.getElem_map] at e1
  have := bound_of_mem_semiSeqs ha (n - 1) (by omega)
  have e2 : (2 * n) - 1 - n = n - 1 := by omega
  simp only [List.length_map, hl, e2] at e1
  omega

end Facts

theorem mem_midSwappable {n : ℕ} {a : List ℕ} :
    a ∈ midSwappable (2 * n) ↔ a ∈ semiSeqs (2 * n) ∧ swapMid n a ∈ semiSeqs (2 * n) := by
  unfold midSwappable; rw [Finset.mem_filter, show (2 * n) / 2 = n by omega]

theorem mem_revMirrorFixed {N : ℕ} {a : List ℕ} :
    a ∈ revMirrorFixed N ↔ a ∈ semiSeqs N ∧ (mirror N a).reverse = a := by
  unfold revMirrorFixed; rw [Finset.mem_filter, revMirror_eq]

/-- **The middle-swap congruence.**  For `N = 2n ≥ 4`, the number of semi-symmetric
sequences whose middle swap is semi-symmetric is congruent modulo 8 to the number of such
sequences that are self-dual. -/
theorem midSwappable_mod_eight {n : ℕ} (hn : 2 ≤ n) :
    (midSwappable (2 * n)).card % 8 =
      ((revMirrorFixed (2 * n)).filter fun a => swapMid n a ∈ semiSeqs (2 * n)).card % 8 := by
  have hY : ∀ a ∈ midSwappable (2 * n), a ∈ semiSeqs (2 * n) ∧ swapMid n a ∈ semiSeqs (2 * n) :=
    fun a ha => mem_midSwappable.1 ha
  have hmem : ∀ a, a ∈ semiSeqs (2 * n) → swapMid n a ∈ semiSeqs (2 * n) →
      a ∈ midSwappable (2 * n) := fun a h1 h2 => mem_midSwappable.2 ⟨h1, h2⟩
  have hlen : ∀ a ∈ semiSeqs (2 * n), a.length = 2 * n := fun a ha => length_of_mem_semiSeqs ha
  have key := card_mod_eight List.reverse (mirror (2 * n)) (swapMid n) (midSwappable (2 * n))
    (fun a ha => by
      obtain ⟨h1, h2⟩ := hY a ha
      refine hmem _ (reverse_mem_semiSeqs h1) ?_
      rw [← reverse_swapMid (by omega) (hlen a h1)]; exact reverse_mem_semiSeqs h2)
    (fun a ha => by
      obtain ⟨h1, h2⟩ := hY a ha
      refine hmem _ (mirror_mem_semiSeqs h1) ?_
      rw [← mirror_swapMid (by omega) (by rw [hlen a h1]; omega)]; exact mirror_mem_semiSeqs h2)
    (fun a ha => by
      obtain ⟨h1, h2⟩ := hY a ha
      refine hmem _ h2 ?_
      rw [swapMid_swapMid (by omega) (by rw [hlen a h1]; omega)]; exact h1)
    (fun _ _ => List.reverse_reverse _)
    (fun a ha => mirror_mirror (mem_semiSeqs.1 (hY a ha).1).1)
    (fun a ha => swapMid_swapMid (by omega) (by rw [hlen a (hY a ha).1]; omega))
    (fun x _ => reverse_mirror _ x)
    (fun a ha => reverse_swapMid (by omega) (hlen a (hY a ha).1))
    (fun a ha => mirror_swapMid (by omega) (by rw [hlen a (hY a ha).1]; omega))
    (fun a ha => reverse_ne_self (by omega) (mem_semiSeqs.1 (hY a ha).1).1)
    (fun a ha => mirror_ne_self (by omega) (mem_semiSeqs.1 (hY a ha).1).1)
    (fun a ha => swapMid_ne_self hn (hY a ha).1)
    (fun a ha => swapMid_reverse_ne hn (hY a ha).1)
    (fun a ha => swapMid_mirror_ne hn (hY a ha).1)
    (fun a ha => swapMid_revMirror_ne hn (hY a ha).1)
  have hF : ((midSwappable (2 * n)).filter fun x => (mirror (2 * n) x).reverse = x) =
      ((revMirrorFixed (2 * n)).filter fun a => swapMid n a ∈ semiSeqs (2 * n)) := by
    ext a
    rw [Finset.mem_filter, Finset.mem_filter, mem_revMirrorFixed, mem_midSwappable]
    tauto
  rw [key, hF]

/-- The self-dual sequences with a semi-symmetric middle swap come in free orbits of
`⟨M, T⟩`, so their number is `≡ 0 (mod 4)`. -/
theorem midSwappable_selfDual_mod_four {n : ℕ} (hn : 2 ≤ n) :
    ((revMirrorFixed (2 * n)).filter fun a => swapMid n a ∈ semiSeqs (2 * n)).card % 4 = 0 := by
  set Z := (revMirrorFixed (2 * n)).filter fun a => swapMid n a ∈ semiSeqs (2 * n) with hZ
  have hmemZ : ∀ a, a ∈ Z ↔ (a ∈ semiSeqs (2 * n) ∧ (mirror (2 * n) a).reverse = a) ∧
      swapMid n a ∈ semiSeqs (2 * n) := fun a => by rw [hZ, Finset.mem_filter, mem_revMirrorFixed]
  have hlen : ∀ a ∈ semiSeqs (2 * n), a.length = 2 * n := fun a ha => length_of_mem_semiSeqs ha
  have h4 := card_mod_four (swapMid n) (mirror (2 * n)) _ Z rfl
    (fun a ha => by
      obtain ⟨⟨h1, h2⟩, h3⟩ := (hmemZ a).1 ha
      refine (hmemZ _).2 ⟨⟨h3, ?_⟩, ?_⟩
      · rw [reverse_mirror, reverse_swapMid (by omega) (hlen a h1), mirror_swapMid (by omega)
          (by simp [hlen a h1]; omega), ← reverse_mirror, h2]
      · rw [swapMid_swapMid (by omega) (by rw [hlen a h1]; omega)]; exact h1)
    (fun a ha => by
      obtain ⟨⟨h1, h2⟩, h3⟩ := (hmemZ a).1 ha
      have hf := (mem_semiSeqs.1 h1).1
      refine (hmemZ _).2 ⟨⟨mirror_mem_semiSeqs h1, ?_⟩, ?_⟩
      · rw [mirror_mirror hf]; conv => lhs; rw [← h2]
        rw [List.reverse_reverse]
      · rw [← mirror_swapMid (by omega) (by rw [hlen a h1]; omega)]; exact mirror_mem_semiSeqs h3)
    (fun a ha => swapMid_swapMid (by omega) (by rw [hlen a ((hmemZ a).1 ha).1.1]; omega))
    (fun a ha => mirror_mirror (mem_semiSeqs.1 ((hmemZ a).1 ha).1.1).1)
    (fun a ha => (mirror_swapMid (by omega) (by rw [hlen a ((hmemZ a).1 ha).1.1]; omega)).symm)
    (fun a ha => swapMid_ne_self hn ((hmemZ a).1 ha).1.1)
    (fun a ha => mirror_ne_self (by omega) (mem_semiSeqs.1 ((hmemZ a).1 ha).1.1).1)
  have h0 : (Z.filter fun x => swapMid n (mirror (2 * n) x) = x) = ∅ := by
    apply Finset.filter_false_of_mem
    intro a ha
    exact swapMid_mirror_ne hn ((hmemZ a).1 ha).1.1
  rw [h0, Finset.card_empty] at h4
  exact h4

/-- Hence `#midSwappable ≡ 0 (mod 4)`. -/
theorem midSwappable_mod_four {n : ℕ} (hn : 2 ≤ n) : (midSwappable (2 * n)).card % 4 = 0 := by
  have h1 := midSwappable_mod_eight hn
  have h2 := midSwappable_selfDual_mod_four hn
  omega

/-- **`a(2n)` modulo 8.**  With `c = c(2n)`, `d` = the number of self-dual sequences whose
middle swap is not semi-symmetric, and `r` = the number of all semi-symmetric sequences whose
middle swap is not semi-symmetric: `a(2n) + d ≡ c + r (mod 8)`. -/
theorem semiCount_mod_eight_mid {n : ℕ} (hn : 2 ≤ n) :
    (semiCount (2 * n) +
        ((revMirrorFixed (2 * n)).filter fun a => swapMid n a ∉ semiSeqs (2 * n)).card) % 8 =
      ((revMirrorFixed (2 * n)).card +
        ((semiSeqs (2 * n)).filter fun a => swapMid n a ∉ semiSeqs (2 * n)).card) % 8 := by
  have h := midSwappable_mod_eight hn
  have s1 := Finset.card_filter_add_card_filter_not (s := semiSeqs (2 * n))
    (fun a => swapMid n a ∈ semiSeqs (2 * n))
  have s2 := Finset.card_filter_add_card_filter_not (s := revMirrorFixed (2 * n))
    (fun a => swapMid n a ∈ semiSeqs (2 * n))
  have e : midSwappable (2 * n) = (semiSeqs (2 * n)).filter
      (fun a => swapMid n a ∈ semiSeqs (2 * n)) := by
    unfold midSwappable; rw [show (2 * n) / 2 = n by omega]
  rw [e] at h
  unfold semiCount
  omega

end Folds
